[Unit]
Description=PerfectCRM daily encrypted Drive backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=RCLONE_CONFIG=/root/.config/rclone/rclone.conf
ExecStart=/bin/bash -c 'set -ae; . /opt/apps/perfectcrm/.env.nightly-backup; exec /opt/apps/perfectcrm/drive-backup.sh'
StandardOutput=append:/var/log/perfectcrm-drive-backup.log
StandardError=append:/var/log/perfectcrm-drive-backup.log

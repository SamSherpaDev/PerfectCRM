<%# locals: (id:, title:, label:, rows:, total:, caption: nil, empty: "None this month.") %>
<%# One "What people build" list: label, how many itineraries, and a bar for the share of the month's itineraries. %>
<section class="card card-pad" aria-labelledby="<%= id %>-heading">
  <h2 class="card-title" id="<%= id %>-heading"><%= title %></h2>
  <% if caption %><%= card_caption caption %><% end %>
  <% if rows.any? %>
    <div class="table-wrap mt-3" tabindex="0" role="region" aria-labelledby="<%= id %>-heading">
      <table class="table table-compact table-plain">
        <thead><tr><th scope="col" class="pr-4"><%= label %></th><th scope="col" class="num pr-3">Itineraries</th><th scope="col" class="w-[34%]"><span class="sr-only">Share of the month</span></th></tr></thead>
        <tbody>
          <% rows.each do |name, count| %>
            <% share = total.positive? ? (count * 100.0 / total).round : 0 %>
            <tr>
              <td class="break-words pr-4"><%= name %></td>
              <td class="num pr-3"><%= count %></td>
              <td><span class="bar block" role="img" aria-label="<%= share %>% of itineraries"><span class="bar-fill" style="width: <%= share %>%"></span></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-3 text-sm muted"><%= empty %></p>
  <% end %>
</section>

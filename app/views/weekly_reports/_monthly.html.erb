<%# locals: (report:) %>
<section class="card card-pad mt-4" aria-labelledby="monthly-sources-heading">
  <h2 class="section-title" id="monthly-sources-heading">Where people come from</h2>
  <%= card_caption "#{WeeklyReport::Monthly::VIEWS.fetch(report.view)}. Travelers inherit the booker's source, not their own discovery." %>
  <%= form_with url: settings_weekly_report_path, method: :get, class: "mt-4 grid gap-3 sm:grid-cols-[180px_minmax(0,1fr)_auto] sm:items-end" do |form| %>
    <div><%= form.label :month, "Month", class: "label" %><%= form.month_field :month, value: report.month.strftime('%Y-%m'), max: Date.current.strftime('%Y-%m'), class: "input" %></div>
    <div class="min-w-0"><%= form.label :view, "Source view", class: "label" %><%= form.select :view, WeeklyReport::Monthly::VIEWS.map { |key, label| [label, key] }, { selected: report.view }, class: "select" %></div>
    <%= form.submit "View", class: "btn-secondary btn btn-sm justify-self-start" %>
  <% end %>
  <p class="hint mt-3">As of <%= report.as_of.strftime('%b %-d, %Y %H:%M %Z') %>. Recomputed from current facts. These source views are alternatives, not additive. <% if report.view == "paid" %>Activity and spend through <%= report.end_date.strftime("%b %-d, %Y") %>, the last completed day.<% end %></p>
  <%= link_to "Review missing sources", leads_path(tab: "missing_source"), class: "link-quiet inline-block mt-3 text-sm" %>
  <div class="table-wrap mt-4" tabindex="0" role="region" aria-label="Monthly source results">
    <table class="table table-compact">
      <thead><tr><th>Source</th><th>Inquiries</th><th>Connected calls</th><th>Bookings</th><th>Travelers</th><th>Net received</th><% if report.view == "paid" %><th>Ad cost / booking</th><% end %></tr></thead>
      <tbody>
        <% report.source_rows.each do |row| %>
          <tr><td><%= row.label %></td><td class="num"><%= row.inquiries %></td><td class="num"><%= row.connected_calls %><span class="hint block"><%= row.reached_ids.size %> inquiries reached</span></td><td class="num"><%= row.booked %></td><td class="num"><%= row.travelers %><% if row.missing_traveler_counts.positive? %><span class="hint block"><%= row.missing_traveler_counts %> counts missing</span><% end %></td><td><%= source_report_money(row.net_received) %></td><% if report.view == "paid" %><td><%= source_report_money(row.cost_per_booking) %></td><% end %></tr>
        <% end %>
        <% total = report.totals %>
        <tr><th class="text-left">All sources</th><td class="num"><%= total[:inquiries] %></td><td class="num"><%= total[:connected_calls] %></td><td class="num"><%= total[:bookings] %></td><td class="num"><%= total[:travelers] %></td><td><%= source_report_money(total[:net_received]) %></td><% if report.view == "paid" %><td>Not blended</td><% end %></tr>
      </tbody>
    </table>
  </div>
  <p class="hint mt-2"><%= total[:unique_people] %> known unique people from stable Client/PerfectBook links; <%= total[:unresolved_identities] %> inquiries with unresolved identity. <% if report.view == "paid" %>Source totals above, campaign detail below. Missing campaign spend keeps source cost unavailable. <% end %>Bookings use the first actual receipt, including those later cancelled. Net received uses receipt/refund event dates. <%= total[:new_bookers] %> distinct new paying bookers; <%= total[:returning_bookers] %> distinct returning paying bookers; <%= total[:repeat_bookings] %> repeat bookings. Recognized revenue: unavailable from PerfectBook. Weekly spend is never split across months.</p>
  <details class="mt-4">
    <summary class="text-sm cursor-pointer">Qualification, cancellations and cash detail</summary>
    <p class="hint mt-2">Q-fit: your fit judgment on the inquiry, no reply required. Platform-qualified: current strong/possible fit plus your move to Chatting or Quoted. They are separate counts.</p>
    <ul class="mt-3 space-y-3 text-sm">
      <% report.rows.each do |row| %>
        <li><p class="font-medium"><%= row.label %></p><p><%= row.q_fit %> Q-fit; <%= row.platform_qualified %> platform-qualified; <%= row.attempts %> other call attempts.</p><p><% if row.inferred_links.positive? %><%= row.inferred_links %> source links inferred, not yet reviewed. <% end %><%= row.personal_referrals %> personally referred inquiries; <%= row.advisor_referrals %> advisor-referred inquiries (separate measures).</p><p><%= row.active %> currently active; <%= row.cancelled %> cancelled/inactive; <%= row.returning %> repeat bookings; <%= row.new_booker_ids.size %> new paying bookers; <%= row.returning_booker_ids.size %> returning paying bookers; <%= row.cancellations_in_month %> cancellations during this month.</p><p>Booked trip value: <%= source_report_money(row.booked_value) %>. Receipts: <%= source_report_money(row.receipts) %>. Refunds: <%= source_report_money(row.refunds) %>.</p><% if report.view == "paid" %><p>Exact daily spend: <%= source_report_money(row.spend) %>. Ad cost / booking: <%= source_report_money(row.cost_per_booking) %>. Ad cost / traveler: <%= source_report_money(row.cost_per_traveler) %>.</p><% end %></li>
      <% end %>
    </ul>
  </details>
  <details class="mt-4">
    <summary class="text-sm cursor-pointer">Inquiry cohort and completeness</summary>
    <% cohort = report.cohorts; quality = report.completeness %>
    <p class="hint mt-2">This month's inquiries followed through the as-of time. Only fully mature inquiries enter each horizon; pending is not failure. Calendar-month cost is a timing ratio, not cohort return.</p>
    <ul class="mt-3 text-sm space-y-1"><% cohort[:horizons].each do |days, facts| %><li>Within <%= days %> days: <%= facts[:booked_inquiries] %> of <%= facts[:eligible] %> mature inquiries booked; <%= facts[:pending] %> pending.</li><% end %></ul>
    <p class="text-sm mt-3">Eventual bookings: <%= cohort[:bookings] %>. Booked value: <%= source_report_money(cohort[:booked_value]) %>. Net received: <%= source_report_money(cohort[:net_received]) %>.</p>
    <p class="text-sm mt-3">Discovery answered: <%= quality[:answered] %> / <%= quality[:inquiries] %>; confirmed: <%= quality[:confirmed] %> / <%= quality[:inquiries] %>. Fit not reviewed: <%= quality[:fit_unreviewed] %>.</p><p class="hint mt-2"><%= quality[:answer_states].map { |state, count| "#{state.humanize}: #{count}" }.join('; ') %>.</p>
    <p class="text-sm mt-2">Calls without inquiry links: <%= quality[:unlinked_calls] %>. Unlinked bookings: <%= quality[:unlinked_bookings] %>. Inferred links: <%= quality[:inferred_bookings] %>. Missing cash facts: <%= quality[:missing_financial_facts] %>. Unavailable mirrors: <%= quality[:unavailable_bookings] %>. Tests held back: <%= quality[:tests_held] %>.<% if quality[:missing_spend] %> Missing spend rows: <%= quality[:missing_spend] %>.<% end %></p>
    <p class="hint mt-2">Across mirror history: <%= quality[:undated_paid_bookings] %> paid bookings have no authoritative first receipt date. Their month is unknown, not guessed from sync time.</p>
    <p class="hint mt-2">Capture: <%= quality[:missing_capture].map { |reason, count| "#{reason.humanize}: #{count}" }.join('; ') %>. <%= quality[:linked_clients] %> distinct linked clients; <%= quality[:unresolved_identities] %> inquiry identities unresolved. Returning travelers are unavailable without stable traveler identity links. Inquiry identities are never guessed from email or names.</p>
  </details>
  <details class="mt-4">
    <summary class="text-sm cursor-pointer">Lifetime bookers, original sources and direct referrals</summary>
    <p class="hint mt-2">Original acquisition, through the as-of time. Original source uses the established client's confirmed or corrected discovery answer, otherwise the earliest eligible first touch, labeled observed. Unknown stays unknown. Unique linked bookings only. Referral values are a separate view and must not be added to original-source totals.</p>
    <h3 class="text-sm font-medium mt-3">Lifetime by booker</h3>
    <ul class="text-sm space-y-2 mt-2">
      <% report.lifetime_bookers.each do |booker| %>
        <li><%= link_to booker[:inquiry].name, lead_path(booker[:inquiry]), class: "link-quiet" %> (PerfectBook contact <%= booker[:contact_id] %>): <%= booker[:source] %>.
          <% booker[:currencies].each do |currency, facts| %><%= currency %>: <%= facts[:bookings] %> bookings, <%= facts[:repeat_bookings] %> repeat; booked value <%= source_report_money({ currency => facts[:booked_value] }) %>. <% end %>
          Net receipts: <%= source_report_money(booker[:net_received]) %>.
        </li>
      <% end %>
    </ul>
    <h3 class="text-sm font-medium mt-3">Original-source lifetime value</h3>
    <ul class="text-sm space-y-2 mt-2"><% report.original_source_lifetime.each do |source| %><li><%= source[:source] %>: <%= source[:bookers] %> bookers; booked value <%= source_report_money(source[:booked_value]) %>; net receipts <%= source_report_money(source[:net_received]) %>.</li><% end %></ul>
    <h3 class="text-sm font-medium mt-3">Direct downstream referrals</h3>
    <ul class="text-sm space-y-2 mt-2"><% report.downstream_referrals.each do |referral| %><li><%= referral[:referrer].name %> referred <%= link_to referral[:inquiry].name, lead_path(referral[:inquiry]), class: "link-quiet" %>; bookings: <%= referral[:bookings].map(&:ref).join(", ").presence || "None" %>; booked value <%= source_report_money(referral[:booked_value]) %>; net receipts <%= source_report_money(referral[:net_received]) %>.</li><% end %></ul>
  </details>
</section>

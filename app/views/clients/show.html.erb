<% content_for :title, "#{@client.name} · PerfectCRM" %>
<div class="page-wide">
  <%= render layout: "shared/page_header", locals: { eyebrow: record_eyebrow(@client), title: @client.name, subtitle: record_subtitle(@client), back: [ "Clients", clients_path ] } do %>
    <%= render "records/header_actions", record: @client %>
  <% end %>
  <%= render "shared/flash" %>
  <% if @client.call_schedulable? && (next_call = @client.next_scheduled_call) %>
    <%= render "scheduled_calls/lead_banner",
      record: @client,
      scheduled_call: next_call,
      return_to: client_path(@client) %>
  <% end %>
  <%= render "records/record", record: @client, read_only: @client.archived? %>
</div>

<%# locals: (owner:, compact: false) %>
<%# The send form shared by the docked reply box (inbox, organization) and
    the record composer (lead, client). `compact` keeps the envelope fields
    folded on every width and shortens the well. The ReplyBox concern
    supplies @reply_conversation, @reply_draft, @reply_to, @reply_data,
    @reply_context, and @reply_chips. %>
<% send_url = owner.is_a?(Client) ? client_messages_path(owner) :
     owner.is_a?(Lead) ? lead_messages_path(owner) : organization_messages_path(owner) %>
<% draft_url = owner.is_a?(Client) ? client_draft_path(owner) :
     owner.is_a?(Lead) ? lead_draft_path(owner) : organization_draft_path(owner) %>
<% conversation = @reply_conversation %>
<% draft = @reply_draft || Draft.new(owner: owner) %>
<% subject_default = conversation ? "Re: #{conversation.display_subject.sub(/\ARe:\s*/i, '')}" : "" %>
<% subject = draft.subject.presence || subject_default %>
<%= form_with url: send_url, scope: :message, html: { novalidate: false, multipart: true }, data: { "reply-box-target": "form", action: "input->reply-box#updateEnvelopeSummary change->reply-box#updateEnvelopeSummary" } do |form| %>
  <% if compact %>
    <p class="reply-to-line">
      To <span data-reply-box-target="recipientSummary"><%= @reply_to.presence || "no address yet" %></span><span data-reply-box-target="subjectSummary"><%= " · #{subject}" if subject.present? %></span> · sends as <%= Mail.mailbox_address %>
    </p>
  <% end %>
  <%= hidden_field_tag :conversation_id, conversation&.id, data: { "reply-box-target": "conversation" } %>
  <%= form.hidden_field :template_id, value: draft.template_id, data: { "reply-box-target": "templateId" } %>

  <%# Envelope fields fold behind Details: always on the record composer,
      on the phone for the docked box. A failed send reopens them so the
      flagged fields stay visible. %>
  <details class="reply-details" <%= "open" if !compact || @envelope_open %> data-reply-box-target="details">
    <summary>Details</summary>
    <div class="mt-3">
      <%= form.label :to, "To", class: "label" %>
      <%= form.text_field :to, value: @reply_to,
            class: "input reply-chips", required: true, autocomplete: "off",
            placeholder: "name@example.com",
            data: { "reply-box-target": "to", action: "change->reply-box#recipientChanged" } %>
    </div>

    <details class="reply-cc">
      <summary>Cc / Bcc</summary>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :cc, "Cc", class: "label" %>
          <%= form.text_field :cc, value: @reply_cc, class: "input", autocomplete: "off" %>
        </div>
        <div>
          <%= form.label :bcc, "Bcc", class: "label" %>
          <%= form.text_field :bcc, value: @reply_bcc, class: "input", autocomplete: "off" %>
        </div>
      </div>
    </details>

    <div class="mt-3" data-reply-box-target="bookingPanel" <%= "hidden" unless @reply_data[:bookings].many? %>>
      <%= form.label :perfectbook_booking_id, "Placeholders fill from", class: "label" %>
      <%= form.select :perfectbook_booking_id,
            options_for_select(@reply_data[:bookings].map { |booking| [ booking[:label], booking[:id] ] }, @reply_data[:selected_booking_id]),
            {}, class: "select", data: { action: "change->reply-box#bookingChanged", "reply-box-target": "booking" } %>
      <p class="hint">Template inserts use this booking's trip, dates, and balance.</p>
    </div>
    <p class="hint" data-reply-box-target="bookingReference" <%= "hidden" unless @reply_context["booking_owner_name"].present? %>>
      <% if @reply_context["booking_owner_name"].present? %>Booking reference: <%= @reply_context["booking_owner_name"] %>'s booking.<% end %>
    </p>

    <div class="mt-3">
      <%= form.label :subject, class: "label" %>
      <%= form.text_field :subject, value: subject,
            class: "input", required: true, autocomplete: "off", placeholder: "Re: your trek",
            data: { "reply-box-target": "subject" } %>
    </div>

    <%= render "reply_box/attachments", draft: draft %>
  </details>

  <div class="mt-3">
    <%= form.label :body, "Message", class: compact ? "sr-only" : "label" %>
    <%= form.text_area :body, value: draft.body, rows: compact ? 3 : 5, required: true,
          class: "textarea reply-body", placeholder: "Hi #{@reply_context['first_name'] || 'there'},",
          data: { "reply-box-target": "body" } %>
  </div>

  <div class="reply-chips" role="group" aria-label="Insert a template">
    <% @reply_chips.each do |template| %>
      <button type="button" class="rchip"
              data-action="reply-box#insertTemplate"
              data-url="<%= use_template_path(template, format: :json) %>"
              data-name="<%= template.name %>"
              title="<%= template.subject %>"><%= template.name %></button>
    <% end %>
  </div>

  <% if owner.respond_to?(:ambiguous_recipient_emails) && owner.ambiguous_recipient_emails.any? %>
    <div class="mt-3">
      <p class="hint">An address was reassigned or restored. Review To, Cc and Bcc before sending. Current contacts:</p>
      <ul class="text-sm">
        <% ([owner] + owner.people.to_a).each do |contact| %>
          <% if contact.email.present? %>
            <li><%= contact.name %>: <%= contact.email %></li>
          <% end %>
        <% end %>
      </ul>
      <%= form.label :recipient_confirmation, class: "label" do %>
        <%= form.check_box :recipient_confirmation, { class: "checkbox", checked: false }, owner.recipient_confirmation_token, "" %>
        I confirm these are the intended current recipients.
      <% end %>
    </div>
  <% end %>

  <div class="reply-actions">
    <p id="draft-status" role="status" class="hint reply-status" data-reply-box-target="status"><% if draft.persisted? %>Draft saved <%= time_ago_in_words(draft.updated_at) %> ago.<% end %></p>
    <%= form.submit "Save draft", formaction: draft_url, formnovalidate: true,
          class: compact ? "btn btn-ghost btn-sm" : "btn btn-secondary", data: { "reply-box-target": "saveButton" } %>
    <%= form.submit "Send", class: "btn btn-primary reply-send" %>
  </div>
<% end %>

<%# Outside the send form on purpose: nested forms would close the outer
    form early and strand Send outside it. %>
<details class="reply-templates">
  <summary>All templates</summary>
  <%= render "templates/picker", templates: ::Template.active.ordered.limit(10), context: @reply_context %>
</details>

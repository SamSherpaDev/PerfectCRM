<div class="mt-3" id="draft-attachments">
  <%= label_tag :message_files, "Attachments", class: "label" %>
  <%= file_field_tag "message[files][]", id: "message_files", multiple: true, class: "input" %>
  <% if draft.files.attached? %>
    <ul class="mt-1 space-y-0.5" aria-label="Draft attachments">
      <% draft.files.each do |file| %>
        <li class="text-xs muted"><%= file.filename %> · kept with the draft</li>
      <% end %>
    </ul>
  <% end %>
</div>

<%# Docked reply box for the organization and inbox thread views (leads and
    clients use records/_composer). Follows docs/DESIGN.md 4.4: recipient
    chips, Re: subject, pressed textarea, template chips in one scrolling
    row, primary Send. On the phone the composer lives in a bottom sheet
    behind a floating Reply pill, so it never covers the thread until the
    captain opens it. Locals: owner (Client, Lead, or Organization). %>
<% conversation = @reply_conversation %>
<% draft = @reply_draft || Draft.new(owner: owner) %>
<% subject_default = conversation ? "Re: #{conversation.display_subject.sub(/\ARe:\s*/i, '')}" : "" %>
<div class="reply-dock" data-controller="reply-box"
     data-reply-box-default-context-value="<%= h @reply_context.to_json %>"
     data-reply-box-context-url-value="<%= reply_context_templates_path(owner_type: owner.class.name, owner_id: owner.id) %>"
     data-reply-box-booking-contexts-value="<%= h @reply_data[:booking_contexts].to_json %>">
  <button type="button" class="reply-pill btn btn-primary"
          data-action="reply-box#toggleComposer" data-reply-box-target="pill">
    <%= render "shared/icon", name: :mail, class: "h-4 w-4" %>
    <span><%= draft.persisted? ? "Resume reply" : "Reply" %></span>
  </button>
  <div class="reply-composer" data-reply-box-target="composer">
<section class="card card-pad reply-box" aria-labelledby="reply-heading">
  <div class="card-header">
    <h2 class="card-title" id="reply-heading">Reply</h2>
    <div class="flex items-center gap-3">
      <% if conversation %>
        <%= link_to "New message", polymorphic_path(owner, new_thread: 1), class: "link-quiet text-xs" %>
      <% end %>
      <button type="button" class="reply-close link-quiet text-xs" data-action="reply-box#toggleComposer">Close</button>
    </div>
  </div>
  <%= card_caption "Replies send as #{Mail.mailbox_address}, in the same thread." %>
  <p class="reply-to-line hidden sm:block">
    Reply to <%= @reply_context["full_name"].presence || @reply_to %><% if subject_default.present? %> · <%= subject_default %><% end %>
  </p>
  <%= render "reply_box/form", owner: owner %>
</section>
  </div>
</div>

<%# One outbound message on the timeline: pressed card, delivery-state
    badge, attachments, and a Retry when delivery failed. Locals: message. %>
<li class="reply-ev" id="message-<%= message.id %>">
  <span class="reply-stone stone-outbound" aria-hidden="true"></span>
  <div class="min-w-0 flex-1">
    <p class="text-xs muted">
      <span class="font-medium text-ink">You</span>
      · <%= time_ago_in_words(message.sent_at || message.created_at) %> ago
      <%= delivery_badge(message.status) %>
      <% if message.template %><span> · <%= message.template.name %></span><% end %>
    </p>
    <div class="msg-outbound">
      <% if message.subject.present? %>
        <p class="text-[13px] font-medium text-ink-2"><%= message.subject %></p>
      <% end %>
      <div class="mt-1 text-sm leading-relaxed text-ink-2 whitespace-pre-line"><%= message.text_body %></div>
      <% if message.files.attached? %>
        <ul class="mt-2 space-y-1" aria-label="Attachments">
          <% message.files.each do |file| %>
            <li class="text-xs">
              <%= link_to file.filename.to_s, attachment_path(file.id),
                    class: "link", download: file.filename.to_s %>
              <span class="muted">· <%= number_to_human_size(file.byte_size) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if message.failed? %>
        <p class="mt-2 text-xs text-bad">Could not deliver: <%= message.send_error.presence || "unknown error" %></p>
        <%= button_to "Retry", retry_message_path(message), method: :post,
              class: "btn btn-secondary btn-sm mt-1" %>
      <% elsif message.status == "queued" || message.status == "sending" %>
        <p class="mt-1 text-xs muted">Sending…</p>
      <% end %>
    </div>
  </div>
</li>

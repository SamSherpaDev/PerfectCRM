<% content_for :title, "Import · PerfectCRM" %>
<div class="page-narrow">
  <%= render layout: "shared/page_header", locals: { eyebrow: "Mailbox", title: "Import", subtitle: "#{@import.scope_label} · #{@import.status.humanize}.", back: [ "Settings", edit_settings_path ] } do %><% end %>
  <%= render "shared/flash" %>

  <% if @import.running? %><meta http-equiv="refresh" content="5"><% end %>
  <% if @import.status == "failed" %><%= button_to "Resume import", commit_mail_import_path(@import), class: "btn-secondary btn" %><% end %>
  <section class="card card-pad" aria-labelledby="progress-heading">
    <h2 class="card-title" id="progress-heading">Progress</h2>
    <%= card_caption "Resumable: if it stops, rerunning continues where it left off." %>
    <div class="bar mt-3" role="progressbar" aria-valuenow="<%= @import.progress_pct %>" aria-valuemin="0" aria-valuemax="100"><span class="bar-fill" style="width: <%= @import.progress_pct %>%"></span></div>
    <dl class="mt-3 space-y-1 text-sm">
      <div class="flex gap-2"><dt class="muted">Processed:</dt><dd><%= @import.processed_messages %> / <%= @import.total_messages %></dd></div>
      <div class="flex gap-2"><dt class="muted">Linked:</dt><dd><%= @import.linked_messages %></dd></div>
      <div class="flex gap-2"><dt class="muted">Unlinked or filtered:</dt><dd><%= @import.skipped_messages %></dd></div>
      <% if @import.error.present? %><div class="flex gap-2"><dt class="muted">Error:</dt><dd class="text-bad"><%= @import.error %></dd></div><% end %>
      <% if @import.finished_at %><div class="flex gap-2"><dt class="muted">Finished:</dt><dd><%= time_24_12(@import.finished_at) %></dd></div><% end %>
    </dl>
    <% if @import.status == "done" %>
      <p class="mt-3 text-sm text-good">Done: <%= @import.linked_messages %> messages linked, <%= @import.skipped_messages %> skipped.</p>
    <% end %>
  </section>

  <% if @rows.any? %>
    <section class="card card-pad mt-6" aria-labelledby="rows-heading">
      <h2 class="card-title" id="rows-heading">Senders</h2>
      <%= card_caption "What the preview found." %>
      <ul class="mt-2 space-y-1 text-sm">
        <% @rows.first(50).each do |row| %>
          <li class="flex justify-between gap-3"><span class="mono text-xs"><%= row["email"] %></span><span class="muted text-xs"><%= row["count"] %> · <%= row["suggested_kind"] %><% if row["duplicate"] %> · duplicate of <%= row["duplicate_name"] %><% end %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

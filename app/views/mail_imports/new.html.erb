<% content_for :title, "Import history · PerfectCRM" %>
<div class="page-narrow">
  <%= render layout: "shared/page_header", locals: { eyebrow: "Mailbox", title: "Import history", subtitle: "Bring past email into the CRM. Preview first — nothing is created until you commit.", back: [ "Settings", edit_settings_path ] } do %><% end %>
  <%= render "shared/flash" %>

  <section class="card card-pad" aria-labelledby="scope-heading">
    <h2 class="card-title" id="scope-heading">How far back?</h2>
    <%= card_caption "Choose all history, mail since a date, or the last N months. There is no 90-day cap." %>
    <%= form_with model: @import, url: mail_imports_path, class: "mt-3 space-y-3" do |form| %>
      <% if @import.errors.any? %>
        <div class="form-errors"><ul><% @import.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
      <% end %>
      <div>
        <%= form.label :scope, "Range", class: "label" %>
        <%= form.select :scope, [ [ "All history", "all" ], [ "Since a date", "since_date" ], [ "Last N months", "last_n_months" ] ], {}, class: "select" %>
      </div>
      <div>
        <%= form.label :since_date, "Since date", class: "label" %>
        <%= form.date_field :since_date, class: "input" %>
      </div>
      <div>
        <%= form.label :months, "Last N months", class: "label" %>
        <%= form.number_field :months, min: 1, max: 120, class: "input", placeholder: "12" %>
      </div>
      <%= form.submit "Preview", class: "btn-primary btn btn-sm" %>
    <% end %>
  </section>
</div>

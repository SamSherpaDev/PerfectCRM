<% content_for :title, "Quote #{@quote.reference} · SherpaHolidays" %>
<div class="w-full max-w-xl">
  <div class="card card-pad">
    <div class="text-center">
      <%= sketch :everest, class: "sk mx-auto h-20 w-full max-w-md" %>
      <p class="eyebrow mt-2">SherpaHolidays · family-run Himalayan adventure travel</p>
      <h1 class="font-display mt-2 text-3xl text-ink">Your quote is ready, <%= @quote.owner_name %></h1>
      <p class="mt-1 text-sm muted">Quote <%= @quote.reference %> · no account needed · just tap below</p>
    </div>
    <%= render "shared/flash" %>

    <% if @quote.status == "accepted" %>
      <div class="callout-neutral callout mt-4" role="status">
        <p class="font-medium">Accepted - thank you!</p>
        <p class="text-sm">Sam will be in touch shortly to confirm your booking.</p>
      </div>
    <% elsif @quote.status == "superseded" %>
      <div class="callout-neutral callout mt-4" role="status">
        <% revision = @quote.revisions.ordered.first %>
        <% if revision&.sent_at.present? && !revision.draft? %>
          <p class="font-medium">A newer quote exists.</p>
          <%= link_to "View the newer quote", public_quote_path(revision.accept_token), class: "link" %>
        <% else %>
          <p class="font-medium">A newer quote is on its way</p>
        <% end %>
      </div>
    <% elsif !@quote.payment_schedule_current? %>
      <div class="callout-warning callout mt-4" role="status">
        <p class="font-medium">This quote's payment schedule needs a refresh.</p>
        <p class="text-sm">Full payment is due for bookings made 90 days or fewer before departure. Ask Sam for a new quote before accepting. These delivered documents stay unchanged.</p>
      </div>
    <% elsif @quote.expired? %>
      <div class="callout-warning callout mt-4" role="status">
        <p class="font-medium">This quote expired on <%= date_short(@quote.valid_until) %>.</p>
        <p class="text-sm">Reply to <%= mail_to "info@sherpaholidays.com" %> and Sam will refresh it for you.</p>
      </div>
    <% end %>

    <div class="mt-6">
      <h2 class="font-display text-xl text-ink"><%= @quote.subject_label %></h2>
      <p class="mt-1 text-sm muted">
        <% details = [] %>
        <% details << @quote.departure_label if @quote.departure_label.present? %>
        <% if @quote.departure_start_on && @quote.departure_end_on %>
          <% details << "#{@quote.departure_start_on.strftime('%-d %b')} – #{@quote.departure_end_on.strftime('%-d %b %Y')}" %>
        <% end %>
        <% details << pluralize(@quote.party_size, "guest") if @quote.party_size %>
        <%= details.join(" · ") %>
      </p>
    </div>

    <ul class="mt-4 divide-y divide-rule-2 border-y border-rule-2">
      <% @quote.lines.each do |line| %>
        <li class="flex items-baseline justify-between gap-4 py-2.5">
          <span class="text-sm text-ink-2"><%= line.description %> <span class="muted">× <%= line.quantity %></span></span>
          <span class="shrink-0 font-display tabular-nums text-ink"><%= money_in(line.total_minor, @quote.currency) %></span>
        </li>
      <% end %>
    </ul>

    <div class="mt-4 text-center">
      <p class="text-xs muted"><%= @quote.party_size ? "Total for #{pluralize(@quote.party_size, 'guest')}" : "Total" %></p>
      <p class="font-display text-3xl tabular-nums text-ink"><%= money_in(@quote.subtotal_minor, @quote.currency) %></p>
      <% if @quote.deposit_minor.to_i.positive? %>
        <p class="mt-1 text-sm muted"><%= @quote.terms_bundle.present? ? "Payment requested now" : "Deposit" %> <%= money_in(@quote.payment_requested_minor, @quote.currency) %><%= " to hold your seats" if @quote.terms_bundle.blank? %> · balance <%= money_in(@quote.remaining_balance_minor, @quote.currency) %><% if @quote.balance_due_on %> due <%= date_short(@quote.balance_due_on) %><% end %></p>
      <% end %>
      <% if @quote.valid_until && !@quote.expired? %>
        <p class="mt-1 text-xs muted">Valid until <%= date_short(@quote.valid_until) %></p>
      <% end %>
    </div>

    <% if @quote.included.present? %>
      <div class="mt-6">
        <h3 class="label">What is included</h3>
        <p class="mt-1 text-sm text-ink-2 whitespace-pre-line"><%= @quote.included %></p>
      </div>
    <% end %>
    <% if @quote.notes.present? %>
      <div class="mt-4 rounded-control bg-paper-3 px-4 py-3 shadow-press">
        <h3 class="label">A note from Sam</h3>
        <p class="mt-1 text-sm text-ink-2 whitespace-pre-line"><%= @quote.notes %></p>
      </div>
    <% end %>

    <% if @quote.terms_bundle.present? %>
      <section class="mt-6 border-t border-rule-2 pt-4" aria-labelledby="booking-terms-heading">
        <h2 id="booking-terms-heading" class="font-display text-xl text-ink">Your booking terms</h2>
        <p class="mt-2 text-sm">Version <%= @quote.terms_bundle.fetch("terms_version") %></p>
        <p class="mt-2 text-sm font-medium">You cancel 45 days or fewer before departure: Cancellation charge: 100% of the total trip price. No refund.</p>
        <p class="mt-2 text-sm">The traveler-cancellation table does not remove our conditions promise, rights under an already accepted booking, or refunds and other rights required by law.</p>
        <% %w[master_terms pre_payment_disclosure trip_differences itinerary].each do |name| %>
          <details class="mt-3">
            <summary class="text-sm font-medium cursor-pointer"><%= { "master_terms" => "Master terms", "pre_payment_disclosure" => "Pre-payment disclosure", "trip_differences" => "Trip-specific differences", "itinerary" => "Itinerary" }.fetch(name) %></summary>
            <div class="mt-2 text-sm text-ink-2 break-words"><%= booking_document_html(@quote.terms_bundle.fetch(name)) %></div>
          </details>
        <% end %>
        <%= link_to "Download booking documents", public_quote_documents_path(@quote.accept_token), class: "link mt-3 inline-block text-sm" %>
        <% if @quote.accepted_terms_version.present? %>
          <p class="mt-2 text-sm">Accepted <%= @quote.accepted_terms_version %> on <%= date_short(@quote.accepted_at) %>.</p>
        <% end %>
      </section>
    <% end %>

    <% if @quote.acceptable? %>
      <div class="mt-6 flex flex-col gap-2">
        <%= form_with url: accept_public_quote_path(@quote.accept_token), method: :post do |form| %>
          <% if @quote.terms_bundle.present? %>
            <%= hidden_field_tag :bundle_sha256, @quote.terms_bundle_sha256 %>
            <label class="mb-3 flex items-start gap-2 text-sm">
              <%= check_box_tag :terms_accepted, "1", false, required: true, class: "checkbox mt-1" %>
              I received and accept the master terms <%= @quote.terms_bundle.fetch("terms_version") %>, pre-payment disclosure, itinerary and listed trip-specific differences. This does not sign a participant release or authorize a payment charge.
            </label>
          <% end %>
          <%= form.submit "Accept this quote", class: "btn btn-primary min-h-11 w-full" %>
        <% end %>
        <%= link_to "Ask a question", "mailto:info@sherpaholidays.com?subject=#{CGI.escape("Question about quote #{@quote.reference}")}", class: "btn btn-secondary w-full" %>
      </div>
      <p class="mt-2 text-center text-xs muted"><% if @quote.terms_bundle.present? %>A booking is confirmed when the required payment and booking acceptance are received and we issue written confirmation. Private journeys also require a signed booking agreement.<% else %>Accepting tells Sam to hold your seats. The booking is confirmed together.<% end %></p>
    <% end %>
  </div>
</div>

<!DOCTYPE html>
<% scheme = current_scheme %>
<html lang="en" data-scheme="<%= scheme %>">
  <head>
    <title><%= content_for(:title) || "PerfectCRM" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PerfectCRM">
    <meta name="mobile-web-app-capable" content="yes">
    <% if scheme == "night" %>
      <meta name="theme-color" content="#14110e">
    <% else %>
      <meta name="theme-color" content="#fcfaee">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" data-scheme="<%= scheme %>">
    <%= render "shared/sketches" %>
    <% if current_user %>
      <div data-controller="sidebar" class="min-h-screen lg:grid lg:grid-cols-[76px_minmax(0,1fr)]">
        <div data-sidebar-target="backdrop" class="fixed inset-0 z-30 hidden bg-rail/70 backdrop-blur-sm lg:hidden" data-action="click->sidebar#close"></div>

        <div class="flex min-w-0 flex-col lg:col-start-2 lg:row-start-1">
          <header class="sticky top-0 z-20 flex items-center gap-3 bg-paper/90 px-4 py-3 backdrop-blur lg:hidden">
            <button type="button" class="btn-ghost btn-sm" data-action="sidebar#open" aria-label="Open menu">
              <%= render "shared/icon", name: :menu, class: "h-5 w-5" %>
            </button>
            <%= link_to root_path, class: "no-underline" do %>
              <%= render "shared/logo", compact: true, on_paper: true %>
            <% end %>
          </header>

          <main class="shell-main flex-1 px-5 py-8 sm:px-12 sm:py-12">
            <%= yield %>
          </main>
        </div>

        <aside data-sidebar-target="panel"
               class="rail group fixed inset-y-0 left-0 z-40 flex w-[264px] -translate-x-full flex-col transition-[transform,width] duration-200 lg:sticky lg:top-0 lg:h-screen lg:w-[76px] lg:translate-x-0 lg:col-start-1 lg:row-start-1 lg:hover:w-[264px] lg:hover:shadow-pop lg:focus-within:w-[264px]">
          <div class="flex items-center justify-between px-5 pt-6 pb-4">
            <%= link_to root_path, class: "flex items-center gap-3 no-underline", title: "PerfectCRM" do %>
              <%= render "shared/logo" %>
            <% end %>
            <button type="button" class="btn-ghost btn-sm text-cream/70 hover:text-cream hover:bg-cream/[0.06] lg:hidden" data-action="sidebar#close" aria-label="Close menu">
              <%= render "shared/icon", name: :close, class: "h-4 w-4" %>
            </button>
          </div>

          <nav class="flex-1 overflow-x-hidden overflow-y-auto px-3 pb-4 [scrollbar-width:thin]" aria-label="Primary">
            <%= render "shared/nav" %>
          </nav>

          <div class="flex items-center gap-3 px-5 py-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cream/10 text-xs font-semibold text-cream" aria-hidden="true"><%= (current_user.name.presence || current_user.email).to_s.first.upcase %></span>
            <div class="rail-label min-w-0">
              <p class="truncate text-sm font-medium text-cream"><%= current_user.name.presence || current_user.email %></p>
              <%= button_to "Sign out", sign_out_path, method: :delete, class: "text-xs text-cream/70 hover:text-cream hover:underline underline-offset-4 decoration-ochre cursor-pointer bg-transparent border-0 p-0" %>
            </div>
          </div>
        </aside>

        <%= render "shared/tabbar" %>
      </div>
    <% else %>
      <div class="signed-out">
        <main class="relative flex flex-1 items-center justify-center px-4 py-12">
          <%= yield %>
        </main>
        <p class="relative pb-6 text-center text-xs muted">Sherpa Holidays · PerfectCRM</p>
      </div>
    <% end %>
  </body>
</html>

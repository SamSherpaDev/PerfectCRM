Good morning — <%= @today.strftime("%A, %-b %-d") %>.

<% if @summary.overdue.any? %>Overdue (<%= @summary.overdue.count %>):
<% @summary.overdue.each do |task| %>- <%= task.title %> (due <%= task.due_on.strftime("%-b %-d") %>)
  <%= polymorphic_url(task.subject) %>
<% end %>
<% else %>Nothing overdue. The desk is clear behind you.
<% end %>
Today (<%= @summary.followups_due.count %>):
<% if @summary.followups_due.any? %><% @summary.followups_due.each do |task| %>- <%= task.title %>
  <%= polymorphic_url(task.subject) %>
<% end %><% else %>- No follow-ups due today.
<% end %>
<% if @summary.missed_calls.any? %>Missed calls (<%= @summary.missed_calls.size %>):
<% @summary.missed_calls.each do |call| %>- <%= call.lead.name %> · <%= call.scheduled_at.in_time_zone.strftime("%-b %-d at %-I:%M %p PT") %><%= " · #{call.notes}" if call.notes.present? %>
  <%= lead_url(call.lead) %>
<% end %>
<% end %><% if @summary.upcoming_calls.any? %>Scheduled calls (<%= @summary.upcoming_calls.size %>):
<% @summary.upcoming_calls.each do |call| %>- <%= call.lead.name %> · <%= call.scheduled_at.in_time_zone.strftime("%-b %-d at %-I:%M %p PT") %><%= " · #{call.notes}" if call.notes.present? %>
  <%= lead_url(call.lead) %>
<% end %>
<% end %>Replies waiting: <%= @summary.waiting_on_you %>.
Calls to make today: <%= @summary.not_yet_called.count %>.
<% if @summary.departing_soon.any? %>
Departing soon:
<% @summary.departing_soon.each do |booking| %>- <%= booking.trip_name %> · <%= booking.start_date.strftime("%-b %-d") %> (<%= booking.party_size %> travelers)
<% end %><% end %>
Open Today: <%= root_url %>

<%# Reusable one-tap picker for the reply box (a later mail task embeds this).
    Emits a window "template:insert" event with {subject, body} detail when the
    captain taps Insert; the reply box listens and fills itself. Each Insert
    also counts a use so dead templates get pruned.
    Locals: templates, query (String). %>
<%= turbo_frame_tag "template_picker" do %>
  <div data-controller="template-picker">
    <%= form_with url: picker_templates_path, method: :get, data: { turbo_frame: "template_picker", action: "input->template-picker#search" } do |form| %>
      <%= form.label :q, "Search templates", class: "sr-only" %>
      <%= form.search_field :q, value: local_assigns[:query], class: "input", placeholder: "Search templates…",
            autocomplete: "off", data: { "template-picker-target": "query" } %>
    <% end %>
    <p class="hint mt-3" role="alert" data-template-picker-target="error" hidden></p>
    <% if templates.empty? %>
      <p class="hint mt-3">No templates match. Try fewer words.</p>
    <% else %>
      <ul class="mt-3 space-y-2" aria-label="Templates">
        <% templates.each do |template| %>
          <% rendered = template.rendered %>
          <li class="rounded-control border border-edge bg-paper-2 px-4 py-3 shadow-raise-sm">
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-ink"><%= template.name %></p>
                <p class="truncate text-xs muted"><%= rendered[:subject].presence || "No subject" %></p>
              </div>
              <button type="button" class="btn btn-secondary btn-sm shrink-0"
                      data-action="template-picker#insert"
                      data-url="<%= use_template_path(template, format: :json) %>"
                      data-name="<%= template.name %>">Insert</button>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<%# locals: (rows:) %>
<%# One row per configured integration and its last run. %>
<section class="card card-pad" aria-labelledby="automations-heading">
  <div class="card-header">
    <h2 class="card-title" id="automations-heading">Automations</h2>
    <%= link_to "Settings", edit_settings_path(anchor: "automations-heading"), class: "link-quiet text-xs" %>
  </div>
  <%= card_caption "What the machines handle, and when each last ran. Quoted, Nudged, and conversion stay manual." %>
  <ul class="mt-2 divide-y divide-rule-2">
    <% rows.each do |row| %>
      <li class="flex flex-wrap items-center justify-between gap-2 py-3">
        <div class="flex min-w-0 items-center gap-3">
          <%= render "shared/icon", name: row[:icon], class: "h-4 w-4 muted" %>
          <div class="min-w-0">
            <p class="text-sm font-medium text-ink"><%= row[:name] %></p>
            <p class="text-xs muted"><%= row[:detail] %></p>
          </div>
        </div>
        <%= badge row[:badge].first, row[:badge].second, dot: true %>
      </li>
    <% end %>
  </ul>
</section>

<% content_for :title, "Leads · PerfectCRM" %>
<div class="page">
  <%= render layout: "shared/page_header", locals: { eyebrow: "Leads", title: "Leads", subtitle: "Everyone who asked and has not booked yet. Convert once, never back." } do %>
    <%= link_to "New lead", new_lead_path, class: "btn-primary btn" %>
  <% end %>
  <%= render "shared/flash" %>

  <%= form_with url: leads_path, method: :get, data: { controller: "autosubmit", turbo_frame: "_top" }, class: "card card-pad" do |form| %>
    <%= hidden_field_tag :tab, @tab %>
    <label class="label" for="lead-search">Search leads</label>
    <div class="flex flex-col gap-2 sm:flex-row">
      <div class="relative flex-1">
        <%= render "shared/icon", name: :search, class: "pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-4" %>
        <%= search_field_tag :q, @query, id: "lead-search", placeholder: "Search name, email, campaign, or note…", autocomplete: "off", class: "input pl-9" %>
      </div>
      <%= select_tag :sort, options_for_select([ [ "Last activity", "activity" ], [ "Name", "name" ], [ "Newest", "newest" ] ], @sort), class: "select sm:w-40", aria_label: "Sort", data: { action: "change->autosubmit#submit" } %>
      <%= submit_tag "Search", class: "btn-secondary btn" %>
    </div>
    <p class="hint">Searches names, emails, campaigns, tags, and note text.</p>
  <% end %>

  <nav class="tabs" data-controller="tab-row" aria-label="Lead stages">
    <%= tab_link "New", leads_path(tab: "new", q: @query, sort: @sort), icon: :plus, active: @tab == "new", count: @counts["new"] %>
    <%= tab_link "Potential", leads_path(tab: "potential", q: @query, sort: @sort), icon: :check, active: @tab == "potential", count: @counts["potential"] %>
    <%= tab_link "Unsure", leads_path(tab: "unsure", q: @query, sort: @sort), icon: :question, active: @tab == "unsure", count: @counts["unsure"] %>
    <%= tab_link "Not interested", leads_path(tab: "not_interested", q: @query, sort: @sort), icon: :void, active: @tab == "not_interested", count: @counts["not_interested"] %>
    <%= tab_link "Archived", leads_path(tab: "archived", q: @query, sort: @sort), icon: :archive, active: @tab == "archived", count: @counts["archived"] %>
  </nav>

  <section class="card" aria-labelledby="leads-heading">
    <div class="card-header">
      <h2 class="card-title" id="leads-heading"><%= @tab.humanize %></h2>
    </div>
    <%= card_caption(lead_tab_caption(@tab)) %>
    <% if @leads.any? %>
      <ul class="divide-y divide-rule-2">
        <% @leads.each do |lead| %>
          <li class="flex flex-col gap-2 px-6 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-7">
            <div class="min-w-0 sm:flex-1">
              <%= link_to lead.name, lead_path(lead, return_to: @lead_action_return_to), class: "link font-medium" %>
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs muted">
                <span class="src inline-flex items-center gap-1.5">
                  <%= render "shared/icon", name: lead_source_icon(lead.source), class: "h-3.5 w-3.5" %>
                  <%= lead_source_label(lead) %>
                </span>
                <% if lead.potential? %><%= badge "Potential", :brand %><% end %>
                <% if lead.unsure? %><%= badge "Unsure", :neutral %><% end %>
                <% if lead.not_interested? %><%= badge "Not interested", :danger %><% end %>
                <%= status_badge(lead.converted? ? "converted" : lead.status) %>
                <% if lead.call_schedulable? && (next_call = lead.next_scheduled_call) %>
                  <%= badge "Call #{next_call.scheduled_at.in_time_zone.strftime('%b %-d, %-I:%M %p')} PT", (next_call.missed? ? :danger : :info), dot: true %>
                <% end %>
                <% lead.tags.each do |tag| %>
                  <%= badge(tag.name == Lead::SUSPECTED_SPAM_TAG ? (lead.spam_marked_at.present? ? "Spam" : "Looks like spam") : tag.name, :brand) %>
                <% end %>
                <% if lead.suspected_spam? && lead.spam_reason.present? %>
                  <span><%= lead.spam_reason %></span>
                <% end %>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs muted sm:max-w-[62%] sm:justify-end">
              <% if lead.archived? %>
                <span>Archived <%= date_short(lead.archived_at) %></span>
                <% if lead.suspected_spam? %>
                  <%= button_to "Not spam", not_spam_lead_path(lead), method: :patch, params: { return_to: @lead_action_return_to }, class: "btn-secondary btn btn-sm" %>
                <% else %>
                  <%= button_to "Restore", unarchive_lead_path(lead), method: :patch, params: { return_to: @lead_action_return_to }, class: "btn-secondary btn btn-sm" %>
                <% end %>
              <% elsif @tab == "archived" %>
                <span>Lost <%= date_short(lead.stage_changed_at) %></span>
              <% else %>
                <span>Active <%= date_short(lead.last_activity) %></span>
                <% if lead.converted_client %>
                  <%= link_to "Open client", client_path(lead.converted_client), class: "link-quiet" %>
                <% else %>
                  <% if lead.call_schedulable? %>
                    <%= render "scheduled_calls/popover",
                      lead: lead,
                      scheduled_call: lead.next_scheduled_call,
                      return_to: @lead_action_return_to,
                      trigger_label: (lead.next_scheduled_call ? "Reschedule" : "Schedule call"),
                      trigger_class: "btn-secondary btn btn-sm",
                      id_prefix: "index_schedule_call_#{lead.id}" %>
                  <% end %>
                  <%= render "leads/potential_action", lead: lead %>
                  <%= render "leads/unsure_action", lead: lead %>
                  <%= render "leads/not_interested_action", lead: lead %>
                  <%= button_to "Mark as spam", mark_as_spam_lead_path(lead), method: :patch, params: { return_to: @lead_action_return_to }, class: "btn-secondary btn btn-sm" %>
                  <% if lead.suspected_spam? %>
                    <%= button_to "Not spam", not_spam_lead_path(lead), method: :patch, params: { return_to: @lead_action_return_to }, class: "btn-secondary btn btn-sm" %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <% if @query.present? %>
        <%= render "shared/empty_state", title: "No matches", body: "Nothing matches that search. Try a name fragment or a campaign.", scene: :cairn %>
      <% elsif @tab == "potential" %>
        <%= render "shared/empty_state", title: "No potential leads yet", body: "Mark Potential on a lead you want to follow up with. They will gather here across stages.", scene: :cairn %>
      <% elsif @tab == "unsure" %>
        <%= render "shared/empty_state", title: "No unsure leads", body: "Mark Unsure on a lead that has not answered yet. They wait here until you know.", scene: :cairn %>
      <% elsif @tab == "not_interested" %>
        <%= render "shared/empty_state", title: "No leads marked not interested", body: "Mark not interested on a lead who does not want to be contacted. They stay out of every call and email list until you choose Interested again.", scene: :cairn %>
      <% elsif @tab == "archived" %>
        <%= render "shared/empty_state", title: "Nothing archived", body: "Archived, spam and lost leads rest here until they need follow-up again.", scene: :cairn %>
      <% else %>
        <%= render "shared/empty_state", title: "No leads here", body: "New asks from ads, the website, and email will gather here for scoring.", scene: :cairn do %>
          <%= link_to "Add your first lead", new_lead_path, class: "btn-primary btn btn-sm" %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>

<%# Lead form: contact facts plus source, campaign, fit, and status. Sentence case. %>
<% if @lead.errors.any? %>
  <div class="form-errors" role="alert">
    <p class="font-medium">Could not save this lead.</p>
    <ul>
      <% @lead.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="grid gap-6">
  <section class="card card-pad" aria-labelledby="lead-facts-heading">
    <h2 class="section-title" id="lead-facts-heading">Facts</h2>
    <%= card_caption "Name and source identify the lead. Campaign and fit come from ads and Panda AI." %>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :name, "Display name", class: "label" %>
        <%= form.text_field :name, required: true, autocomplete: "off", class: "input" %>
      </div>
      <div>
        <%= form.label :email, "Primary email", class: "label" %>
        <%= form.email_field :email, autocomplete: "off", class: "input", placeholder: "traveler@example.com" %>
      </div>
      <div>
        <%= form.label :phone, "Phone", class: "label" %>
        <%= form.telephone_field :phone, autocomplete: "off", class: "input" %>
      </div>
      <div>
        <%= form.label :country, class: "label" %>
        <%= form.text_field :country, class: "input" %>
      </div>
      <div>
        <%= form.label :state, "State or region", class: "label" %>
        <%= form.text_field :state, class: "input" %>
      </div>
      <div>
        <%= form.label :kind, class: "label" %>
        <%= form.select :kind, Lead::KINDS.map { |kind| [ kind.humanize, kind ] }, {}, class: "select" %>
      </div>
      <div>
        <%= form.label :status, class: "label" %>
        <%= form.select :status, Lead::STATUSES.map { |status| [ status.humanize, status ] }, {}, class: "select" %>
      </div>
      <div>
        <%= form.label :lost_reason, "Lost reason", class: "label" %>
        <%= form.select :lost_reason, [ [ "Still talking", "" ] ] + Lead::LOST_REASONS.map { |reason| [ reason.humanize, reason ] }, {}, class: "select" %>
        <p class="hint">Required when the stage is Lost.</p>
      </div>
      <div>
        <%= form.label :lost_note, "Lost note", class: "label" %>
        <%= form.text_field :lost_note, class: "input", placeholder: "What happened, in one line…" %>
      </div>
      <div>
        <%= form.label :source, class: "label" %>
        <%= form.select :source, Lead::SOURCES.map { |source| [ source.humanize, source ] }, {}, class: "select" %>
      </div>
      <div>
        <%= form.label :campaign_name, "Campaign", class: "label" %>
        <%= form.text_field :campaign_name, class: "input", placeholder: "Everest spring" %>
      </div>
      <div>
        <%= form.label :external_ref, "External reference", class: "label" %>
        <%= form.text_field :external_ref, class: "input", placeholder: "n8n id for idempotency" %>
        <p class="hint">Never shown to travelers. Keeps automation imports idempotent.</p>
      </div>
      <div>
        <%= form.label :perfectbook_contact_id, "PerfectBook contact id", class: "label" %>
        <%= form.number_field :perfectbook_contact_id, min: 1, class: "input" %>
      </div>
      <div>
        <%= form.label :referred_by_organization_id, "Referred by", class: "label" %>
        <%= form.collection_select :referred_by_organization_id, Organization.order(:name), :id, :name, { include_blank: "No referrer" }, class: "select" %>
      </div>
      <div>
        <%= form.label :trip_interest, "Trip interest", class: "label" %>
        <%= form.text_field :trip_interest, class: "input", placeholder: "Everest Base Camp" %>
      </div>
      <div>
        <%= form.label :expected_value_dollars, "Expected value (USD)", class: "label" %>
        <%= form.number_field :expected_value_dollars, min: 0, step: "0.01", class: "input", placeholder: "2500" %>
        <p class="hint">Your estimate. Feeds the pipeline totals.</p>
      </div>
      <div>
        <%= form.label :fit_score, "Fit score", class: "label" %>
        <%= form.number_field :fit_score, min: 0, max: 100, class: "input", placeholder: "0 to 100 from Panda AI" %>
      </div>
      <div>
        <%= form.label :fit_band, "Fit band", class: "label" %>
        <%= form.select :fit_band, [ [ "Scoring…", "" ] ] + Lead::FIT_BANDS.map { |band| [ band.humanize, band ] }, {}, class: "select" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :fit_reason, "Fit reason", class: "label" %>
        <%= form.text_area :fit_reason, rows: 2, class: "textarea", placeholder: "Why Panda AI scored it this way…" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :tag_list, "Tags", class: "label" %>
        <%= form.text_field :tag_list, class: "input", placeholder: "everest-interested, honeymoon" %>
      </div>
    </div>
  </section>

  <section class="card card-pad" aria-labelledby="lead-people-heading">
    <h2 class="section-title" id="lead-people-heading">People</h2>
    <%= card_caption "Spouses and fellow travelers on this ask." %>
    <div class="mt-4 space-y-4">
      <%= form.fields_for :people do |person_form| %>
        <fieldset class="rounded-control border border-rule bg-paper-3/40 p-4">
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <%= person_form.label :name, class: "label" %>
              <%= person_form.text_field :name, class: "input", placeholder: "Full name" %>
            </div>
            <div>
              <%= person_form.label :role, "Role", class: "label" %>
              <%= person_form.text_field :role, class: "input", placeholder: "Spouse, traveler" %>
            </div>
            <div>
              <%= person_form.label :email, class: "label" %>
              <%= person_form.email_field :email, class: "input" %>
            </div>
            <div>
              <%= person_form.label :phone, class: "label" %>
              <%= person_form.telephone_field :phone, class: "input" %>
            </div>
          </div>
          <% if person_form.object.persisted? %>
            <label class="mt-3 inline-flex items-center gap-2 text-xs muted">
              <%= person_form.check_box :_destroy, class: "checkbox" %> Remove this person
            </label>
          <% end %>
        </fieldset>
      <% end %>
    </div>
  </section>
</div>

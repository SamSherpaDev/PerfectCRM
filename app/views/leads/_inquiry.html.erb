<%# locals: (lead:) %>
<%# What the visitor asked, from the website form. %>
<% if lead.message.present? || lead.trip_title.present? || lead.trip_handle.present? ||
      lead.party_size.present? || lead.travel_month.present? || lead.travel_year.present? ||
      lead.budget_band.present? || lead.reference.present? %>
  <section class="card card-pad" aria-labelledby="inquiry-heading">
    <div class="card-header">
      <h2 class="card-title" id="inquiry-heading">Inquiry</h2>
    </div>
    <%= card_caption "What they wrote on the website, word for word." %>
    <dl class="facts mt-2">
      <% if lead.reference.present? %>
        <div>
          <dt>Reference</dt>
          <dd class="mono text-xs"><%= lead.reference %></dd>
        </div>
      <% end %>
      <div>
        <dt>Has in mind</dt>
        <dd><%= lead.trip_title.presence || lead.trip_handle.presence || "Not sure yet" %></dd>
      </div>
      <% if lead.message.present? %>
        <div>
          <dt>Message</dt>
          <dd class="whitespace-pre-line"><%= lead.message %></dd>
        </div>
      <% end %>
      <% if lead.party_size.present? || lead.travel_month.present? || lead.travel_year.present? || lead.budget_band.present? %>
        <div>
          <dt>Details</dt>
          <dd>
            <%= pluralize(lead.party_size, "traveler") if lead.party_size.present? %><% if lead.travel_month.present? || lead.travel_year.present? %><%= ", " if lead.party_size.present? %><%= Date::MONTHNAMES[lead.travel_month] if lead.travel_month %><%= " #{lead.travel_year}" if lead.travel_year %><% end %><% if lead.budget_band.present? %><%= ", " if lead.party_size.present? || lead.travel_month.present? || lead.travel_year.present? %><%= lead.budget_band.humanize %> per person<% end %>
          </dd>
        </div>
      <% end %>
      <% if lead.placement.present? %>
        <div>
          <dt>Placed on</dt>
          <dd><%= lead.placement.humanize %> page</dd>
        </div>
      <% end %>
      <% if lead.received_at.present? %>
        <div>
          <dt>Received</dt>
          <dd><%= time_24_12(lead.received_at) %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>

<% content_for :title, "#{@lead.name} · PerfectCRM" %>
<% read_only = @lead.converted? || @lead.archived? %>
<div class="page-wide">
  <%= render layout: "shared/page_header", locals: { eyebrow: record_eyebrow(@lead), title: @lead.name, subtitle: record_subtitle(@lead), back: [ "Leads", leads_path ] } do %>
    <%= render "records/header_actions", record: @lead %>
  <% end %>
  <%= render "shared/flash" %>
  <%= render "records/record", record: @lead, read_only: read_only %>
</div>

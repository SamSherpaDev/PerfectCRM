<% content_for :title, "#{@lead.name} · PerfectCRM" %>
<% read_only = @lead.converted? || @lead.archived? %>
<div class="page-wide">
  <%= render layout: "shared/page_header", locals: { eyebrow: record_eyebrow(@lead), title: @lead.name, subtitle: record_subtitle(@lead), back: [ "Leads", @lead_action_return_to ] } do %>
    <%= render "records/header_actions", record: @lead %>
  <% end %>
  <%= render "shared/flash" %>
  <% if @lead.suspected_spam? && !@lead.converted? %>
    <section class="card card-pad mb-5" aria-label="Spam review">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <% reason_suffix = @lead.spam_reason.present? ? " (#{@lead.spam_reason})" : "" %>
        <% if @lead.spam_marked_at.present? %>
          <p class="text-sm muted">Marked as spam and archived<%= reason_suffix %>. Choose Not spam to restore this inquiry.</p>
        <% elsif @lead.archived? %>
          <p class="text-sm muted">Looks like spam<%= reason_suffix %>. Confirm your verdict, or choose Not spam to restore this inquiry.</p>
        <% else %>
          <p class="text-sm muted">Looks like spam<%= reason_suffix %>. Confirm to archive, or keep this inquiry as a real lead.</p>
        <% end %>
        <% if @lead.spam_marked_at.nil? %>
          <div class="flex flex-wrap gap-2">
            <%= button_to "Mark as spam", mark_as_spam_lead_path(@lead), method: :patch, params: { return_to: @lead_action_return_to }, class: "btn-secondary btn btn-sm" %>
            <% unless @lead.archived? %>
              <%= button_to "Not spam", not_spam_lead_path(@lead), method: :patch, params: { return_to: @lead_action_return_to }, class: "btn-secondary btn btn-sm" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
  <%= render "records/record", record: @lead, read_only: read_only %>
</div>

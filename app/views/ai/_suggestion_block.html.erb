<%# One follow-up proposal. Accept creates a real Task; nothing auto-creates. %>
<%= turbo_frame_tag "ai-suggestion-#{conversation.id}" do %>
  <section class="card card-pad ai-suggestion mt-4" aria-labelledby="ai-suggestion-heading-<%= conversation.id %>">
    <h2 class="card-title" id="ai-suggestion-heading-<%= conversation.id %>">Suggested next action</h2>
    <%= card_caption "One follow-up at a time. Accept it to create the task." %>
    <% if defined?(fallback) && fallback.present? %>
      <p class="hint mt-2" role="status"><%= render "ai/fallback_text", fallback: fallback %></p>
    <% elsif conversation.ai_suggestion_title.present? %>
      <div class="mt-2 rounded-control border border-edge bg-paper-2 px-4 py-3">
        <p class="text-sm font-medium text-ink"><%= conversation.ai_suggestion_title %></p>
        <p class="hint mt-1">Due <%= date_short(conversation.ai_suggestion_due_on) %><% if conversation.ai_suggestion_reason.present? %> · <%= conversation.ai_suggestion_reason %><% end %></p>
        <div class="mt-2">
          <%= button_to "Accept — create follow-up", ai_accept_conversation_suggestion_path(conversation),
                method: :post, class: "btn-primary btn btn-sm" %>
        </div>
      </div>
    <% end %>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <%= button_to "Suggest next action", ai_conversation_suggestion_path(conversation),
            method: :post, class: "btn-secondary btn btn-sm",
            data: { turbo_frame: "ai-suggestion-#{conversation.id}" },
            form: { data: { action: "submit->ai-assist#working" } } %>
      <span data-ai-assist-target="orbSlot" hidden></span>
    </div>
  </section>
<% end %>

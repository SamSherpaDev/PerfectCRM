<% content_for :title, "Settings · PerfectCRM" %>
<div class="page-narrow">
  <%= render layout: "shared/page_header", locals: { eyebrow: "PerfectCRM", title: "Settings", subtitle: "How the desk looks and behaves. More controls will join this page as features land." } do %><% end %>
  <%= render "shared/flash" %>

  <%= form_with model: @settings, url: settings_path, method: :patch, data: { controller: "appearance", action: "change->appearance#apply" } do |form| %>
    <section class="card card-pad" aria-labelledby="appearance-heading">
      <h2 class="section-title" id="appearance-heading">Appearance</h2>
      <%= card_caption "Applies the moment you choose it; Paper by default, Night is the ink scheme with the same drawings." %>
      <div class="segment mt-4" role="radiogroup" aria-labelledby="appearance-heading">
        <% { "paper" => [ "Paper", :sun ], "night" => [ "Night", :moon ] }.each do |value, (label, icon)| %>
          <label>
            <%= form.radio_button :appearance, value %>
            <%= render "shared/icon", name: icon, class: "h-3.5 w-3.5" %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
      <p id="appearance-status" role="status" class="hint" data-appearance-target="status"></p>
    </section>
  <% end %>

  <section class="card card-pad mt-6" aria-labelledby="perfectbook-heading">
    <h2 class="section-title" id="perfectbook-heading">PerfectBook connection</h2>
    <%= card_caption "Reads bookings and the trip catalog from PerfectBook. PerfectBook stays the system of record; this app only mirrors status." %>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <% if @perfectbook_configured %>
        <%= status_badge "connected", label: "Configured" %>
      <% else %>
        <%= status_badge "disconnected", label: "Unconfigured" %>
      <% end %>
      <span class="hint">Catalog and bookings sync every 15 minutes.</span>
    </div>
    <dl class="mt-4 space-y-1 text-sm">
      <div class="flex gap-2">
        <dt class="muted">Last successful sync:</dt>
        <dd><%= @perfectbook_last_success ? time_24_12(@perfectbook_last_success) : "Never" %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Last error:</dt>
        <dd><%= @perfectbook_last_error&.last_error.presence || "None" %></dd>
      </div>
    </dl>
    <div class="mt-4">
      <%= button_to "Test connection", perfectbook_test_settings_path, method: :post, class: "btn-secondary" %>
    </div>
  </section>

  <section class="card card-pad mt-6" aria-labelledby="mailbox-heading">
    <h2 class="section-title" id="mailbox-heading">Mailbox</h2>
    <%= card_caption "Microsoft 365 mail to and from #{@mailbox_address} lands on client timelines. Only that address is ever kept; personal mail is skipped without storing it." %>
    <dl class="mt-4 space-y-1 text-sm">
      <div class="flex gap-2">
        <dt class="muted">Mailbox address:</dt>
        <dd class="font-medium text-ink"><%= @mailbox_address %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Status:</dt>
        <dd>
          <% if @settings.mailbox_grant_revoked? %>
            <%= status_badge "error", label: "Reconnect needed" %>
          <% elsif @settings.mailbox_connected? %>
            <%= status_badge "connected", label: "Connected" %>
          <% else %>
            <%= status_badge "disconnected", label: "Not connected" %>
          <% end %>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Last sync:</dt>
        <dd><%= @settings.mailbox_last_sync_at ? time_24_12(@settings.mailbox_last_sync_at) : "Never" %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Last error:</dt>
        <dd><%= @settings.mailbox_last_error.presence || @mailbox_error&.last_error.presence || "None" %></dd>
      </div>
    </dl>
    <% if @mailbox_notices.any? %>
      <div class="mt-4">
        <p class="text-sm font-medium text-ink">Worth a look</p>
        <ul class="mt-1 space-y-1 text-sm text-ink-2">
          <% @mailbox_notices.each do |state| %>
            <li><%= state.last_notice %> <span class="muted"><%= time_24_12(state.last_notice_at) %></span></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% if @settings.mailbox_connected? %>
        <%= link_to "Test connection", mailbox_test_settings_path, data: { turbo_method: :post }, class: "btn-secondary btn btn-sm" %>
        <%= button_to "Reconnect mailbox", mailbox_connect_settings_path, method: :post, data: { turbo: false }, class: "btn-secondary btn btn-sm" %>
      <% elsif @graph_configured %>
        <%= button_to "Connect mailbox", mailbox_connect_settings_path, method: :post, data: { turbo: false }, class: "btn-primary btn btn-sm" %>
      <% else %>
        <p class="hint">Add <span class="mono">MS_GRAPH_CLIENT_ID</span>, <span class="mono">MS_GRAPH_CLIENT_SECRET</span> and <span class="mono">MS_GRAPH_TENANT_ID</span> to <span class="mono">.env.app</span> first — see README “Mail” — then connect here.</p>
      <% end %>
    </div>
    <p class="hint mt-4">Setup: register the CRM as a Microsoft application, add the delegated mail scopes, paste the credentials into .env.app, then Connect mailbox. Sync runs every 5 minutes over every mail folder, child folders included, read-only — it never moves, deletes, or flags server mail. A first connect starts from now; earlier mail is not synced. See README “Mail”.</p>
  </section>

  <section class="card card-pad mt-6" aria-labelledby="automations-heading">
    <h2 class="section-title" id="automations-heading">Automations</h2>
    <%= card_caption "Website inquiries and automatic first replies. Conversion to client and all follow-up replies stay manual." %>

    <div class="mt-4 space-y-4">
      <div class="setting">
        <div class="k">
          <p class="font-medium text-sm">Site key</p>
          <p class="hint">Public identifier the storefront form sends with every inquiry. Last used <%= @settings.site_key_last_used_at ? time_24_12(@settings.site_key_last_used_at) : "never" %>.</p>
          <p class="mono mt-1 text-xs"><%= @settings.site_key %></p>
        </div>
        <%= button_to "Rotate", rotate_site_key_settings_path, method: :post, class: "btn-secondary btn btn-sm", form: { data: { turbo_confirm: "Rotate the site key? Update the storefront block right after." } } %>
      </div>
    </div>

    <%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-4 space-y-4" do |form| %>
      <div class="setting">
        <div class="k">
          <%= form.label :auto_first_reply_enabled, "Automatic first reply", class: "font-medium text-sm" %>
          <p class="hint">
            New website inquiries only, after two minutes. Sends the live First reply template once per email address. All other replies stay manual. Lead and client replies send an alert to info@sherpaholidays.com.
            <%= link_to "Edit First reply template", first_reply_template ? edit_template_path(first_reply_template) : new_template_path(purpose: "first_reply"), class: "link" %>
          </p>
        </div>
        <%= form.check_box :auto_first_reply_enabled, class: "checkbox" %>
      </div>
      <p class="hint">One copy of every website inquiry goes to info@sherpaholidays.com, with Reply-To the visitor.</p>
      <div>
        <%= form.submit "Save automations", class: "btn-primary btn btn-sm" %>
      </div>
    <% end %>

    <div class="mt-6">
      <h3 class="card-title">Recent automation activity</h3>
      <%= card_caption "The last 50 machine events and webhook deliveries, newest first." %>
      <% if @automation_events.any? || @webhook_deliveries.any? %>
        <ul class="mt-2 space-y-3">
          <% @automation_events.each do |event| %>
            <li class="flex items-start gap-3">
              <%= render "shared/icon", name: automation_icon(automation_caller(event)), class: "h-4 w-4 mt-0.5 text-info" %>
              <div class="min-w-0">
                <p class="text-sm text-ink"><%= event.summary %></p>
                <p class="text-xs muted"><%= time_24_12(event.occurred_at) %></p>
              </div>
              <%= badge "Automated", :info, dot: true %>
            </li>
          <% end %>
          <% @webhook_deliveries.each do |delivery| %>
            <li class="flex items-start gap-3">
              <%= render "shared/icon", name: :external, class: "h-4 w-4 mt-0.5 muted" %>
              <div class="min-w-0">
                <p class="text-sm text-ink"><%= delivery.event %> to <%= delivery.url %></p>
                <p class="text-xs muted"><%= time_24_12(delivery.created_at) %><% if delivery.lead %> · <%= link_to delivery.lead.reference || delivery.lead.name, lead_path(delivery.lead), class: "link-quiet" %><% end %></p>
              </div>
              <%= status_badge(delivery.status == "delivered" ? "sent" : delivery.status == "failed" ? "error" : "pending") %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="empty-inline">
          <%= sketch :enso, class: "enso" %>
          <p class="text-sm text-ink">No automation activity yet.</p>
          <p class="text-xs muted">Website inquiries, Panda AI verdicts, and webhook deliveries will appear here.</p>
        </div>
      <% end %>
      <% if @honeypot_caught.positive? %>
        <p class="hint mt-3"><%= @honeypot_caught %> submission<%= "s" unless @honeypot_caught == 1 %> caught by the hidden trap field and archived as spam.</p>
      <% end %>
    </div>
  </section>

  <%= render "settings/ad_conversions", settings: @settings, recent: @ad_conversions_recent,
    delivery_counts: @ad_conversion_delivery_counts, google_waiting: @google_feed_waiting, fresh_password: @fresh_google_feed_password %>

  <section class="card card-pad" aria-labelledby="signature-heading">
    <h2 class="section-title" id="signature-heading">Signature</h2>
    <%= card_caption "Your logo and sign-off on every reply, quote, and {{signature}}. Type your name on the first line; the logo is added for you." %>
    <% if EmailSignature.logo_attached?(@settings) %>
      <div class="mt-4 flex items-center gap-3">
        <% fitted_logo = EmailSignature.logo_box(@settings) %>
        <%= image_tag logo_settings_path, alt: "Signature logo", width: fitted_logo&.first, height: fitted_logo&.last, style: fitted_logo ? "width:#{fitted_logo.first}px;height:#{fitted_logo.last}px;" : nil %>
        <%= button_to "Remove logo", signature_logo_settings_path, method: :delete, class: "btn-ghost btn btn-sm" %>
      </div>
    <% end %>
    <%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :sender_name, "Your name", class: "label" %>
        <%= form.text_field :sender_name, class: "input", autocomplete: "off", placeholder: "Sam" %>
        <p class="hint">Fills {{my_name}} in templates and signs the From line.</p>
      </div>
      <div>
        <%= form.label :signature_logo, "Logo", class: "label" %>
        <%= form.file_field :signature_logo, accept: "image/png,image/jpeg,image/gif", class: "input" %>
        <p class="hint">PNG, JPEG, or GIF under 500 KB. It travels inside every email, never as a link, so it shows without a download-images prompt.</p>
      </div>
      <div>
        <%= form.label :email_signature, "Signature lines", class: "label" %>
        <%= form.text_area :email_signature, value: EmailSignature.text_for(@settings), rows: 3, class: "textarea", placeholder: "Sam Sherpa\nSherpaHolidays" %>
        <p class="hint">First line is your name. Added under every reply and fills {{signature}} too.</p>
      </div>
      <% if @settings.errors[:signature_logo].any? %>
        <p class="text-sm text-bad" role="alert"><%= @settings.errors.full_messages_for(:signature_logo).to_sentence %></p>
      <% end %>
      <div>
        <span class="label">Preview</span>
        <div class="sig-preview" id="signature-preview"><%== EmailSignature.html_for(@settings, logo_src: logo_settings_path) %></div>
        <p class="hint">How it looks at the bottom of an email.</p>
      </div>
      <div>
        <%= form.submit "Save email settings", class: "btn-secondary btn btn-sm" %>
      </div>
    <% end %>
  </section>

  <section class="card card-pad" aria-labelledby="reviews-heading">
    <h2 class="section-title" id="reviews-heading">Google reviews</h2>
    <%= card_caption "The link travelers tap to write a review. It fills {{google_review_link}} in the Review ask template." %>
    <%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :google_review_url, "Write-review link", class: "label" %>
        <%= form.url_field :google_review_url, class: "input", autocomplete: "off", placeholder: "https://g.page/r/…/review" %>
        <p class="hint">Copy it from your Google Business Profile under "Ask for reviews". Until it is set, the link line is left out of the email.</p>
      </div>
      <% if @settings.errors[:google_review_url].any? %>
        <p class="text-sm text-bad" role="alert">Write-review link <%= @settings.errors[:google_review_url].to_sentence %>.</p>
      <% end %>
      <div>
        <%= form.submit "Save review link", class: "btn-secondary btn btn-sm" %>
      </div>
    <% end %>
  </section>

  <footer class="mt-6 text-center text-xs muted">
    <%= link_to "Export everything", settings_export_path, class: "link-quiet" %> · CSV zip of leads, clients, people, organizations, notes, tags, and timeline events.
  </footer>
  <div class="foot-sketch" aria-hidden="true">
    <%= sketch :wheel, class: "sk scene" %>
  </div>
</div>

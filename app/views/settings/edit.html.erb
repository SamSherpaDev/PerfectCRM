<% content_for :title, "Settings · PerfectCRM" %>
<div class="page-narrow">
  <%= render layout: "shared/page_header", locals: { eyebrow: "PerfectCRM", title: "Settings", subtitle: "How the desk looks and behaves. More controls will join this page as features land." } do %><% end %>
  <%= render "shared/flash" %>

  <%= form_with model: @settings, url: settings_path, method: :patch, data: { controller: "appearance", action: "change->appearance#apply" } do |form| %>
    <section class="card card-pad" aria-labelledby="appearance-heading">
      <h2 class="section-title" id="appearance-heading">Appearance</h2>
      <%= card_caption "Applies the moment you choose it; Paper by default, Night is the ink scheme with the same drawings." %>
      <div class="segment mt-4" role="radiogroup" aria-labelledby="appearance-heading">
        <% { "paper" => [ "Paper", :sun ], "night" => [ "Night", :moon ] }.each do |value, (label, icon)| %>
          <label>
            <%= form.radio_button :appearance, value %>
            <%= render "shared/icon", name: icon, class: "h-3.5 w-3.5" %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
      <p id="appearance-status" role="status" class="hint" data-appearance-target="status"></p>
    </section>
  <% end %>

  <section class="card card-pad mt-6" aria-labelledby="perfectbook-heading">
    <h2 class="section-title" id="perfectbook-heading">PerfectBook connection</h2>
    <%= card_caption "Reads bookings and the trip catalog from PerfectBook. PerfectBook stays the system of record; this app only mirrors status." %>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <% if @perfectbook_configured %>
        <%= status_badge "connected", label: "Configured" %>
      <% else %>
        <%= status_badge "disconnected", label: "Unconfigured" %>
      <% end %>
      <span class="hint">Catalog and bookings sync every 15 minutes.</span>
    </div>
    <dl class="mt-4 space-y-1 text-sm">
      <div class="flex gap-2">
        <dt class="muted">Last successful sync:</dt>
        <dd><%= @perfectbook_last_success ? time_24_12(@perfectbook_last_success) : "Never" %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Last error:</dt>
        <dd><%= @perfectbook_last_error&.last_error.presence || "None" %></dd>
      </div>
    </dl>
    <div class="mt-4">
      <%= button_to "Test connection", perfectbook_test_settings_path, method: :post, class: "btn-secondary" %>
    </div>
  </section>

  <section class="card card-pad" aria-labelledby="digest-heading">
    <h2 class="section-title" id="digest-heading">Morning digest</h2>
    <%= card_caption "A short email at 7am Pacific with today's follow-ups, overdue items, and departures to watch." %>
    <%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-4" do |form| %>
      <div class="flex flex-wrap items-center gap-3">
        <%= form.check_box :digest_enabled, class: "checkbox" %>
        <%= form.label :digest_enabled, "Send the morning digest", class: "text-sm text-ink-2" %>
        <%= form.submit "Save", class: "btn-secondary btn btn-sm" %>
      </div>
    <% end %>
  </section>

  <section class="card card-pad mt-6" aria-labelledby="mailbox-heading">
    <h2 class="section-title" id="mailbox-heading">Mailbox</h2>
    <%= card_caption "Microsoft 365 mail to and from #{@mailbox_address} lands on client timelines. Only that address is ever kept; personal mail is skipped without storing it." %>
    <dl class="mt-4 space-y-1 text-sm">
      <div class="flex gap-2">
        <dt class="muted">Mailbox address:</dt>
        <dd class="font-medium text-ink"><%= @mailbox_address %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Status:</dt>
        <dd>
          <% if @settings.mailbox_grant_revoked? %>
            <%= status_badge "error", label: "Reconnect needed" %>
          <% elsif @settings.mailbox_connected? %>
            <%= status_badge "connected", label: "Connected" %>
          <% else %>
            <%= status_badge "disconnected", label: "Not connected" %>
          <% end %>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Last sync:</dt>
        <dd><%= @settings.mailbox_last_sync_at ? time_24_12(@settings.mailbox_last_sync_at) : "Never" %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Last error:</dt>
        <dd><%= @settings.mailbox_last_error.presence || @mailbox_error&.last_error.presence || "None" %></dd>
      </div>
    </dl>
    <% if @mailbox_notices.any? %>
      <div class="mt-4">
        <p class="text-sm font-medium text-ink">Worth a look</p>
        <ul class="mt-1 space-y-1 text-sm text-ink-2">
          <% @mailbox_notices.each do |state| %>
            <li><%= state.last_notice %> <span class="muted"><%= time_24_12(state.last_notice_at) %></span></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% if @settings.mailbox_connected? %>
        <%= link_to "Test connection", mailbox_test_settings_path, data: { turbo_method: :post }, class: "btn-secondary btn btn-sm" %>
        <%= button_to "Reconnect mailbox", mailbox_connect_settings_path, method: :post, data: { turbo: false }, class: "btn-secondary btn btn-sm" %>
      <% elsif @graph_configured %>
        <%= button_to "Connect mailbox", mailbox_connect_settings_path, method: :post, data: { turbo: false }, class: "btn-primary btn btn-sm" %>
      <% else %>
        <p class="hint">Add <span class="mono">MS_GRAPH_CLIENT_ID</span>, <span class="mono">MS_GRAPH_CLIENT_SECRET</span> and <span class="mono">MS_GRAPH_TENANT_ID</span> to <span class="mono">.env.app</span> first — see README “Mail” — then connect here.</p>
      <% end %>
    </div>
    <p class="hint mt-4">Setup: register the CRM as a Microsoft application, add the delegated mail scopes, paste the credentials into .env.app, then Connect mailbox. Sync runs every 5 minutes over every mail folder, child folders included, read-only — it never moves, deletes, or flags server mail. A first connect starts from now; past mail stays for Import history. See README “Mail”.</p>
  </section>

  <section class="card card-pad mt-6" aria-labelledby="import-heading">
    <h2 class="section-title" id="import-heading">Import history</h2>
    <%= card_caption "Bring past email with clients and operators into the CRM. Preview first, flip clients and organizations per row, then import." %>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= link_to "Import history", new_mail_import_path, class: "btn-secondary btn btn-sm" %>
      <%= link_to "Past imports", mail_imports_path, class: "btn-ghost btn btn-sm" %>
    </div>
    <% if @imports.any? %>
      <ul class="mt-3 space-y-1 text-sm">
        <% @imports.each do |import| %>
          <li><%= link_to "#{import.scope_label} · #{import.status}", mail_import_path(import), class: "link" %></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="card card-pad mt-6" aria-labelledby="pipeline-digest-heading">
    <h2 class="section-title" id="pipeline-digest-heading">Monday pipeline note</h2>
    <%= card_caption "One line every Monday at 7am: open leads, stale cards, and pipeline value." %>
    <%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-4" do |form| %>
      <label class="inline-flex items-center gap-2 text-sm">
        <%= form.check_box :pipeline_digest, class: "checkbox" %>
        Send the Monday note to info@sherpaholidays.com
      </label>
      <div class="mt-3">
        <%= form.submit "Save", class: "btn-secondary btn btn-sm" %>
      </div>
    <% end %>
  </section>

  <section class="card card-pad mt-6" aria-labelledby="automations-heading">
    <h2 class="section-title" id="automations-heading">Automations</h2>
    <%= card_caption "The website form, Panda AI scoring, and the n8n webhooks. Automations may create leads, score them, and move them between New, Chatting and Lost. Quoted, Nudged, conversion to client, and everything after stay manual." %>

    <div class="mt-4 space-y-4">
      <div class="setting">
        <div>
          <p class="font-medium text-sm">Site key</p>
          <p class="hint">Public identifier the storefront form sends with every inquiry. Last used <%= @settings.site_key_last_used_at ? time_24_12(@settings.site_key_last_used_at) : "never" %>.</p>
          <p class="mono mt-1 text-xs"><%= @settings.site_key %></p>
        </div>
        <%= button_to "Rotate", rotate_site_key_settings_path, method: :post, class: "btn-secondary btn btn-sm", form: { data: { turbo_confirm: "Rotate the site key? Update the storefront block right after." } } %>
      </div>

      <div class="setting">
        <div>
          <p class="font-medium text-sm">Relay secret</p>
          <p class="hint">Signs server calls from n8n and Panda AI, and signs the webhooks sent to n8n. Last used <%= @settings.relay_last_used_at ? time_24_12(@settings.relay_last_used_at) : "never" %>.</p>
          <% if @fresh_relay_secret %>
            <p class="mono mt-1 text-xs" role="status">New secret (shown once): <%= @fresh_relay_secret %></p>
          <% else %>
            <p class="mono mt-1 text-xs"><%= @settings.masked_relay_secret %></p>
          <% end %>
        </div>
        <%= button_to "Rotate", rotate_relay_secret_settings_path, method: :post, class: "btn-secondary btn btn-sm", form: { data: { turbo_confirm: "Rotate the relay secret? Update n8n and Panda AI right after." } } %>
      </div>
    </div>

    <%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-4 space-y-4" do |form| %>
      <p class="hint">One copy of every website inquiry goes to info@sherpaholidays.com, with Reply-To the visitor.</p>
      <div>
        <%= form.label :lead_webhook_url, "n8n webhook URL", class: "label" %>
        <%= form.url_field :lead_webhook_url, class: "input mono text-xs", placeholder: "https://n8n.example.com/webhook/lead" %>
        <p class="hint">Each new lead and each details answer is posted here, signed with the relay secret. Empty means disabled.</p>
      </div>
      <div>
        <%= form.submit "Save automations", class: "btn-primary btn btn-sm" %>
      </div>
    <% end %>

    <div class="mt-6">
      <h3 class="card-title">Recent automation activity</h3>
      <%= card_caption "The last 50 machine events and webhook deliveries, newest first." %>
      <% if @automation_events.any? || @webhook_deliveries.any? %>
        <ul class="mt-2 space-y-3">
          <% @automation_events.each do |event| %>
            <li class="flex items-start gap-3">
              <%= render "shared/icon", name: automation_icon(automation_caller(event)), class: "h-4 w-4 mt-0.5 text-info" %>
              <div class="min-w-0">
                <p class="text-sm text-ink"><%= event.summary %></p>
                <p class="text-xs muted"><%= time_24_12(event.occurred_at) %></p>
              </div>
              <%= badge "Automated", :info, dot: true %>
            </li>
          <% end %>
          <% @webhook_deliveries.each do |delivery| %>
            <li class="flex items-start gap-3">
              <%= render "shared/icon", name: :external, class: "h-4 w-4 mt-0.5 muted" %>
              <div class="min-w-0">
                <p class="text-sm text-ink"><%= delivery.event %> to <%= delivery.url %></p>
                <p class="text-xs muted"><%= time_24_12(delivery.created_at) %><% if delivery.lead %> · <%= link_to delivery.lead.reference || delivery.lead.name, lead_path(delivery.lead), class: "link-quiet" %><% end %></p>
              </div>
              <%= status_badge(delivery.status == "delivered" ? "sent" : delivery.status == "failed" ? "error" : "pending") %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="empty-inline">
          <%= sketch :enso, class: "enso" %>
          <p class="text-sm text-ink">No automation activity yet.</p>
          <p class="text-xs muted">Website inquiries, Panda AI verdicts, and webhook deliveries will appear here.</p>
        </div>
      <% end %>
      <% if @honeypot_dropped.to_i.positive? %>
        <p class="hint mt-3"><%= @honeypot_dropped %> spam-bot submission<%= "s" unless @honeypot_dropped.to_i == 1 %> quietly dropped at the door.</p>
      <% end %>
    </div>
  </section>

  <section class="card card-pad" aria-labelledby="signature-heading">
    <h2 class="section-title" id="signature-heading">Signature</h2>
    <%= card_caption "Your logo and sign-off on every reply, quote, and {{signature}}. Paste the formatted version from Outlook, or type plain lines and the uploaded logo is added for you." %>
    <% if EmailSignature.logo_attached?(@settings) %>
      <div class="mt-4 flex items-center gap-3">
        <%= image_tag logo_settings_path, alt: "Signature logo", class: "h-12 w-auto" %>
        <%= button_to "Remove logo", signature_logo_settings_path, method: :delete, class: "btn-ghost btn btn-sm" %>
      </div>
    <% end %>
    <%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-4 space-y-4", data: { controller: "signature-preview", signature_preview_url_value: signature_preview_settings_path } do |form| %>
      <div>
        <%= form.label :sender_name, "Your name", class: "label" %>
        <%= form.text_field :sender_name, class: "input", autocomplete: "off", placeholder: "Sam" %>
        <p class="hint">Fills {{my_name}} in templates and signs the From line.</p>
      </div>
      <div>
        <%= form.label :signature_logo, "Logo", class: "label" %>
        <%= form.file_field :signature_logo, accept: "image/png,image/jpeg,image/gif", class: "input", data: { signature_preview_target: "file", action: "change->signature-preview#logoChanged" } %>
        <p class="hint">PNG, JPEG, or GIF under 500 KB. It travels inside every email, never as a link, so it shows without a download-images prompt.</p>
      </div>
      <div>
        <%= form.label :email_signature, "Plain lines", class: "label" %>
        <%= form.text_area :email_signature, rows: 3, class: "textarea", placeholder: "Sam Sherpa\nSherpa Holidays", data: { signature_preview_target: "text", action: "input->signature-preview#schedule" } %>
        <p class="hint">Added under every reply. Fills {{signature}} too. With a logo, these lines build the formatted signature.</p>
      </div>
      <div>
        <%= form.label :email_signature_html, "Formatted signature", class: "label" %>
        <%= form.text_area :email_signature_html, rows: 6, class: "textarea mono text-xs", placeholder: "<p>Sam Sherpa<br>Sherpa Holidays</p>", data: { signature_preview_target: "html", action: "input->signature-preview#schedule" } %>
        <p class="hint">Paste the formatted version from Outlook, pictures and all: pasted pictures are swapped for the uploaded logo. Leave it empty to build from the plain lines.</p>
      </div>
      <% if @settings.errors[:signature_logo].any? %>
        <p class="text-sm text-bad" role="alert"><%= @settings.errors.full_messages_for(:signature_logo).to_sentence %></p>
      <% end %>
      <div>
        <span class="label">Preview</span>
        <div class="textarea min-h-24" data-signature-preview-target="output"><%== EmailSignature.preview_html(html: @settings.email_signature_html, text: @settings.email_signature, setting: @settings) %></div>
        <p class="hint">Exactly as the email will look.</p>
      </div>
      <div>
        <%= form.submit "Save email settings", class: "btn-secondary btn btn-sm" %>
      </div>
    <% end %>
  </section>

  <section class="card card-pad" aria-labelledby="export-heading">
    <h2 class="section-title" id="export-heading">Export everything</h2>
    <%= card_caption "A zip of leads, clients, people, organizations, notes, tags, and timeline events as CSV. Opens cleanly in Excel." %>
    <div class="mt-4">
      <%= link_to "Export everything", settings_export_path, class: "btn-secondary btn btn-sm" %>
    </div>
  </section>

  <section class="card card-pad mt-6" aria-labelledby="ai-heading">
    <h2 class="section-title" id="ai-heading">AI assistance</h2>
    <%= card_caption "Approval-only drafts, summaries, suggestions, and triage. Nothing is ever sent or created without your tap. See README \u201CAI assistance\u201D." %>
    <dl class="mt-4 space-y-1 text-sm">
      <div class="flex gap-2">
        <dt class="muted">Calls today:</dt>
        <dd><%= @ai_calls_today %> · <%= number_to_currency(@ai_cost_today / 100.0) %> estimated</dd>
      </div>
      <div class="flex gap-2">
        <dt class="muted">Prompt version:</dt>
        <dd><%= Ai::Prompts.version %></dd>
      </div>
    </dl>
    <%= form_with model: @settings, url: ai_settings_path, method: :patch, class: "mt-4 space-y-3" do |form| %>
      <div class="flex flex-wrap items-center gap-3">
        <%= form.check_box :ai_enabled, class: "checkbox" %>
        <%= form.label :ai_enabled, "Enable AI assistance (kill switch)", class: "text-sm text-ink-2" %>
      </div>
      <p class="hint">On by default. Turn it off any time to stop every AI call immediately.</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :ai_model, "Model", class: "label" %>
          <%= form.text_field :ai_model, class: "input", placeholder: "gpt-4o-mini", autocomplete: "off" %>
        </div>
      </div>
      <div>
        <%= form.label :ai_base_url, "Base URL (OpenAI-compatible)", class: "label" %>
        <%= form.text_field :ai_base_url, class: "input", placeholder: "https://api.openai.com/v1 or https://openrouter.ai/api/v1", autocomplete: "off" %>
      </div>
      <div>
        <%= form.label :ai_api_key, "API key", class: "label" %>
        <%= form.password_field :ai_api_key, class: "input", placeholder: @settings.ai_api_key.present? ? "Saved — enter a new one to replace it" : "sk-…", autocomplete: "new-password" %>
        <p class="hint">Stored encrypted. Leaving it blank keeps the saved key.</p>
      </div>
      <div>
        <%= form.label :ai_voice_guide, "Voice guide", class: "label" %>
        <%= form.text_area :ai_voice_guide, class: "textarea", rows: 3, placeholder: "Short, warm, plain-spoken. Sign as Sam." %>
        <p class="hint">Your templates are the style examples; this guide steers tone.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :ai_daily_cost_cap_cents, "Daily cost cap (cents)", class: "label" %>
          <%= form.number_field :ai_daily_cost_cap_cents, class: "input", min: 0, step: 1 %>
          <p class="hint">AI stops for the day once estimated spend reaches this.</p>
        </div>
        <div>
          <%= form.label :ai_rate_limit_per_minute, "Calls per minute", class: "label" %>
          <%= form.number_field :ai_rate_limit_per_minute, class: "input", min: 1, max: 120, step: 1 %>
        </div>
      </div>
      <% if @settings.errors.any? %>
        <p class="text-sm text-bad"><%= @settings.errors.full_messages.to_sentence %></p>
      <% end %>
      <%= form.submit "Save AI assistance", class: "btn-primary btn btn-sm" %>
    <% end %>
    <p class="hint mt-4">\u201CAlways show me the draft before it sends\u201D is on and cannot be turned off: there is no auto-send setting. Prices, availability promises, and legal or refund language stay human. To opt one client, lead, or organization out, edit their record and tick \u201COpt out of AI assistance\u201D.</p>
  </section>
  <div class="foot-sketch" aria-hidden="true">
    <%= sketch :wheel, class: "sk scene" %>
  </div>
</div>

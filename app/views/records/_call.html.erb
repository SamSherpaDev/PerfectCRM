<%# locals: (record:) %>
<%# One tap logs an outbound call now; Add details keeps time, direction and duration. Each rendered form carries one save key, so a double tap logs one call. %>
<%# Forms skip Turbo so the redirect keeps its #record-details anchor, which reopens the phone Details tab. %>
<% lead = record.is_a?(Lead) %>
<% inquiries = lead ? [record] : Lead.where(converted_client_id: record.id).or(Lead.where(existing_client_id: record.id)).order(created_at: :desc) %>
<% calls_path = lead ? lead_calls_path(record) : client_calls_path(record) %>
<% if inquiries.any? %>
  <section class="calls" aria-labelledby="calls-heading">
    <h3 class="calls-title" id="calls-heading">Log a call</h3>
    <% inquiries.each do |inquiry| %>
      <% inquiry_name = inquiry.reference.presence || inquiry.name %>
      <div class="calls-inquiry" <%= tag.attributes(role: "group", aria: { label: "Calls for #{inquiry_name}" }) unless lead %>>
        <% unless lead %>
          <p class="calls-for">For <%= inquiry_name %><% if (trip = inquiry.trip_interest.presence || inquiry.trip_title.presence) %><span class="muted"> · <%= trip %></span><% end %></p>
        <% end %>
        <% next_call = inquiry.next_scheduled_call %>
        <% if lead && record.call_schedulable? && next_call&.due_by?(Time.current) %>
          <p class="hint">Next call: <%= scheduled_call_stamp(next_call) %>. Log the outcome in the scheduled call bar above, or add details below.</p>
        <% else %>
          <%= form_with url: calls_path, class: "call-choices", data: { turbo: false } do |form| %>
            <%= form.hidden_field :save_key, value: SecureRandom.uuid, id: nil %>
            <%= form.hidden_field :direction, value: "outbound", id: nil %>
            <% unless lead %><%= form.hidden_field :inquiry_id, value: inquiry.id, id: nil %><% end %>
            <% CallLog::ONE_TAP.each do |outcome| %>
              <%= button_tag CallLog::LABELS.fetch(outcome), name: "outcome", value: outcome, class: "btn-secondary btn-sm" %>
            <% end %>
          <% end %>
        <% end %>
        <% recent = inquiry.activity_events.where(kind: "call").order(occurred_at: :desc, id: :desc).limit(3).to_a %>
        <% if recent.any? %>
          <ul class="calls-recent" aria-label="Recent calls">
            <% recent.each do |call| %>
              <li>
                <span><%= CallLog::LABELS.fetch(call.metadata["outcome"].to_s, call.metadata["outcome"].to_s.humanize) %><% if call.metadata["direction"] == "inbound" %><span class="muted">, they called</span><% end %></span>
                <time datetime="<%= call.occurred_at.iso8601 %>"><%= timeline_stamp(call.occurred_at) %></time>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="hint">No calls yet. A tap logs an outbound call now.</p>
        <% end %>
      </div>
    <% end %>
    <details class="mt-3">
      <summary class="link-quiet text-xs">Add details</summary>
      <p class="hint mt-2">For a call they made, an earlier time, or a duration.</p>
      <%= form_with url: calls_path, class: "mt-3 space-y-3", data: { turbo: false } do |form| %>
        <%= form.hidden_field :save_key, value: SecureRandom.uuid %>
        <% unless lead %>
          <div>
            <%= form.label :inquiry_id, "Inquiry", class: "label" %>
            <%= form.select :inquiry_id, inquiries.map { |inquiry| [inquiry.reference.presence || inquiry.name, inquiry.id] }, {}, class: "select" %>
          </div>
        <% end %>
        <div>
          <%= form.label :occurred_at, "Call time", class: "label" %>
          <%= form.datetime_local_field :occurred_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), required: true, class: "input" %>
        </div>
        <div>
          <%= form.label :outcome, class: "label" %>
          <%= form.select :outcome, CallLog::LABELS.map { |outcome, label| [label, outcome] }, {}, class: "select" %>
        </div>
        <div>
          <%= form.label :direction, class: "label" %>
          <%= form.select :direction, [["Outbound", "outbound"], ["Inbound", "inbound"]], {}, class: "select" %>
        </div>
        <div>
          <%= form.label :duration, "Duration in seconds (optional)", class: "label" %>
          <%= form.number_field :duration, min: 0, max: 86400, class: "input" %>
        </div>
        <%= form.submit "Save call", class: "btn-secondary" %>
      <% end %>
    </details>
  </section>
<% elsif !lead %>
  <details class="mt-4">
    <summary class="link-quiet text-xs">Log a call</summary>
    <p class="hint mt-2">Start an inquiry to keep this call separate from past trips.</p>
    <%= link_to "New inquiry", new_lead_path(existing_client_id: record.id, name: record.name, email: record.email, capture_channel: "phone"), class: "link text-xs" %>
  </details>
<% end %>

<%# locals: (record:) %>
<% inquiries = record.is_a?(Lead) ? [record] : Lead.where(converted_client_id: record.id).or(Lead.where(existing_client_id: record.id)).order(created_at: :desc) %>
<% if inquiries.any? %>
  <details class="mt-4">
    <summary class="link-quiet text-xs">Log a call</summary>
    <%= form_with url: record.is_a?(Lead) ? lead_calls_path(record) : client_calls_path(record), class: "mt-3 space-y-3" do |form| %>
      <%= form.hidden_field :save_key, value: SecureRandom.uuid %>
      <% unless record.is_a?(Lead) %>
        <div>
          <%= form.label :inquiry_id, "Inquiry", class: "label" %>
          <%= form.select :inquiry_id, inquiries.map { |inquiry| [inquiry.reference.presence || inquiry.name, inquiry.id] }, {}, class: "select" %>
        </div>
      <% end %>
      <div>
        <%= form.label :occurred_at, "Call time", class: "label" %>
        <%= form.datetime_local_field :occurred_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), required: true, class: "input" %>
      </div>
      <div>
        <%= form.label :outcome, class: "label" %>
        <%= form.select :outcome, CallLog::OUTCOMES.map { |outcome| [outcome.humanize, outcome] }, {}, class: "select" %>
      </div>
      <div>
        <%= form.label :direction, class: "label" %>
        <%= form.select :direction, [["Outbound", "outbound"], ["Inbound", "inbound"]], {}, class: "select" %>
      </div>
      <div>
        <%= form.label :duration, "Duration in seconds (optional)", class: "label" %>
        <%= form.number_field :duration, min: 0, max: 86400, class: "input" %>
      </div>
      <%= form.submit "Save call", class: "btn-secondary" %>
    <% end %>
  </details>
<% elsif record.is_a?(Client) %>
  <details class="mt-4">
    <summary class="link-quiet text-xs">Log a call</summary>
    <p class="hint mt-2">Start an inquiry to keep this call separate from past trips.</p>
    <%= link_to "New inquiry", new_lead_path(existing_client_id: record.id, name: record.name, email: record.email, capture_channel: "phone"), class: "link text-xs" %>
  </details>
<% end %>

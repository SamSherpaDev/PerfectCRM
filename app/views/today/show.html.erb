<% content_for :title, "Today · PerfectCRM" %>
<div class="page">
  <%= render layout: "shared/page_header", locals: { eyebrow: "Sherpa Holidays", title: "Today", subtitle: "Welcome, #{current_user.name.presence || current_user.email} · #{Date.current.strftime('%A, %B %-d')} · what is waiting on you, in one glance." } do %><% end %>
  <%= render "shared/flash" %>

  <section aria-label="Counts">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
      <div class="stat">
        <p class="stat-value"><%= @summary.waiting_on_you %></p>
        <p class="text-sm text-ink-2">Waiting on you</p>
        <p class="hint">Replies owed, newest first.</p>
      </div>
      <div class="stat">
        <p class="stat-value"><%= @summary.new_leads %></p>
        <p class="text-sm text-ink-2">New leads</p>
        <p class="hint">Fresh in, not yet worked.</p>
      </div>
      <div class="stat col-span-2 sm:col-span-1">
        <p class="stat-value"><%= @summary.active_clients %></p>
        <p class="text-sm text-ink-2">Active clients</p>
        <p class="hint">On the books, not archived.</p>
      </div>
    </div>
  </section>

  <% added_from_email, unlinked = @summary.unlinked_inquiries.partition { |message| message.conversation.linkable.is_a?(Lead) } %>
  <% if added_from_email.any? %>
    <aside class="callout-warning" aria-label="Added to New from email">
      <details>
        <summary class="cursor-pointer py-3 text-sm"><strong>Added to New from email: <%= added_from_email.size %></strong> · Review</summary>
        <p class="mt-2 text-sm">Recent inquiry mail added to New with its email thread. Review and triage each lead:</p>
        <ul class="mt-2 space-y-1 text-sm">
          <% added_from_email.each do |message| %>
            <% lead = message.conversation.linkable %>
            <li><%= link_to message.subject.presence || lead.name.presence || "(no subject)", lead_path(lead), class: "link break-words" %></li>
          <% end %>
        </ul>
      </details>
    </aside>
  <% end %>
  <% if unlinked.any? %>
    <aside class="callout-warning" aria-label="Unlinked inquiries">
      <details>
        <summary class="cursor-pointer py-3 text-sm"><strong>Unlinked inquiries: <%= unlinked.size %></strong> · Review</summary>
        <p class="mt-2 text-sm">Recent inquiry mail waiting for the daily check to add to New:</p>
        <ul class="mt-2 space-y-1 text-sm">
          <% unlinked.each do |message| %>
            <li><%= link_to message.subject.presence || "(no subject)", inbox_thread_path(message.conversation), class: "link break-words" %></li>
          <% end %>
        </ul>
      </details>
    </aside>
  <% end %>

  <%= render "scheduled_calls/calendar", summary: @summary %>

  <section class="card card-pad" aria-labelledby="not-yet-called-heading">
    <div class="card-header">
      <h2 class="card-title" id="not-yet-called-heading">Not yet called</h2>
      <%= badge @summary.not_yet_called.count, :neutral %>
    </div>
    <%= card_caption "New inquiries over one business day old, with no personal reply or logged call. Oldest first; Monday to Friday." %>
    <% inquiries = @summary.not_yet_called %>
    <% if inquiries.any? %>
      <ul class="rowlist">
        <% inquiries.each do |lead| %>
          <li>
            <div class="who">
              <%= link_to lead.name, lead_path(lead), class: "n link" %>
              <span class="s"><%= lead.trip_interest.presence || "Trip inquiry" %></span>
            </div>
            <div class="meta">
              <span>Received <%= date_short((lead.received_at || lead.created_at).to_date) %></span>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="empty-inline">
        <%= sketch :enso, class: "enso" %>
        <p class="text-sm text-ink">No inquiries waiting for first contact.</p>
        <p class="text-xs muted">Older new inquiries will appear here until you reply or log a call.</p>
      </div>
    <% end %>
  </section>

  <section class="card card-pad" aria-labelledby="replies-heading">
    <div class="card-header">
      <h2 class="card-title" id="replies-heading">Replies waiting</h2>
    </div>
    <%= card_caption "Threads awaiting your reply or call. Automatic greetings stay here." %>
    <% replies = @summary.replies_waiting %>
    <% if replies.any? %>
      <ul class="rowlist">
        <% replies.each do |conversation| %>
          <% last = conversation.messages.find(&:inbound?) %>
          <li class="<%= "unread" if conversation.unread_count.to_i > 0 %>">
            <div class="who">
              <%= link_to conversation.linkable_name || conversation.display_subject, inbox_thread_path(conversation), class: "n link" %>
              <span class="s"><%= last&.preview_text(120) %></span>
            </div>
            <div class="meta">
              <span><%= last&.sent_at ? time_ago_in_words(last.sent_at) + " ago" : "" %></span>
              <% if conversation.unread_count.to_i > 0 %>
                <%= badge "Unread", :brand, dot: true %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
      <% if @summary.waiting_on_you > replies.size %>
        <p class="mt-3"><%= link_to "Open the inbox", inbox_path(tab: "waiting"), class: "link" %></p>
      <% end %>
    <% else %>
      <div class="empty-inline">
        <%= sketch :enso, class: "enso" %>
        <p class="text-sm text-ink">No replies waiting.</p>
        <p class="text-xs muted">New client mail will queue here once the inbox connects.</p>
      </div>
    <% end %>
  </section>
</div>

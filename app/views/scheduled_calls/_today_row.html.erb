<%# locals: (scheduled_call:, return_to:) %>
<% owner = scheduled_call.owner %>
<% inquiries = owner.inquiries.limit(2).to_a if owner.is_a?(Client) %>
<li class="scheduled-call-row<%= ' scheduled-call-row-missed' if scheduled_call.missed? %>" id="scheduled_call_<%= scheduled_call.id %>">
  <div class="scheduled-call-row-main">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to owner.name, polymorphic_path(owner), class: "link font-medium" %>
      <% if owner.respond_to?(:potential?) && owner.potential? %><%= badge "Potential", :brand %><% end %>
      <% if scheduled_call.missed? %>
        <%= badge "Missed", :danger, dot: true %>
      <% elsif scheduled_call.today? %>
        <%= badge "Today", :info, dot: true %>
      <% end %>
    </div>
    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs muted">
      <time datetime="<%= scheduled_call.scheduled_at.iso8601 %>" class="font-medium text-ink-2">
        <%= scheduled_call_stamp(scheduled_call) %>
      </time>
      <% if owner.display_phone.present? %>
        <span><%= owner.display_phone %></span>
      <% end %>
      <% if owner.respond_to?(:trip_interest) && (trip = owner.trip_interest.presence || owner.trip_title.presence) %>
        <span><%= trip %></span>
      <% end %>
    </div>
    <% if scheduled_call.notes.present? %>
      <p class="mt-1 text-xs text-ink-2"><%= scheduled_call.notes %></p>
    <% end %>
  </div>

  <div class="scheduled-call-row-actions">
    <% if inquiries.nil? || inquiries.one? %>
      <%= render "scheduled_calls/outcomes", record: owner, scheduled_call: scheduled_call, return_to: return_to,
        inquiry: inquiries&.first, button_class: "btn-secondary btn-xs" %>
    <% else %>
      <%= link_to "Log on client page", client_path(owner, anchor: "scheduled-call"), class: "btn-secondary btn-xs" %>
    <% end %>

    <%= render "scheduled_calls/popover",
      record: owner,
      scheduled_call: scheduled_call,
      return_to: return_to,
      trigger_label: "Reschedule",
      trigger_class: "btn-secondary btn-xs",
      id_prefix: "today_reschedule_#{scheduled_call.id}" %>

    <%= button_to "Cancel",
      polymorphic_path([:cancel, owner, scheduled_call]),
      method: :patch,
      params: { return_to: return_to },
      class: "btn-secondary btn-xs" %>
  </div>
</li>

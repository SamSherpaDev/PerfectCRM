<%# locals: (record:, scheduled_call: nil, return_to: nil, trigger_label: nil, trigger_class: "btn-secondary btn-sm", submit_label: nil, id_prefix: nil) %>
<details class="call-schedule-pop">
  <summary class="<%= trigger_class %>">
    <%= render "shared/icon", name: "phone", class: "h-3.5 w-3.5" %>
    <span><%= trigger_label.presence || (scheduled_call&.persisted? ? "Reschedule" : "Schedule call") %></span>
  </summary>
  <div class="call-schedule-sheet">
    <%= render "scheduled_calls/form",
      record: record,
      scheduled_call: scheduled_call,
      return_to: return_to,
      submit_label: submit_label,
      id_prefix: id_prefix %>
  </div>
</details>

<%# locals: (lead: nil, record: nil, scheduled_call: nil, return_to: nil, submit_label: nil, id_prefix: nil) %>
<% owner = record || lead || scheduled_call&.owner %>
<% call = scheduled_call || ScheduledCall.new(owner.is_a?(Client) ? { client: owner } : { lead: owner }) %>
<% persisted = call.persisted? %>
<% url = persisted ? polymorphic_path([owner, call]) : polymorphic_path([owner, :scheduled_calls]) %>
<% method = persisted ? :patch : :post %>
<% prefix = id_prefix.presence || (persisted ? "reschedule_call_#{call.id}" : "schedule_call_#{owner.model_name.param_key}_#{owner.id}") %>
<% today_date = Time.zone.today %>
<% tomorrow_date = today_date + 1.day %>
<% next_monday = today_date.next_occurring(:monday) %>
<% default_date = call.scheduled_on.presence || tomorrow_date.iso8601 %>
<% default_time = call.scheduled_time.presence || "10:00" %>
<% default_duration = call.duration_minutes.presence || 30 %>
<% button_text = submit_label.presence || (persisted ? "Save changes" : "Schedule call") %>

<%= form_with model: [owner, call], url: url, method: method, class: "call-schedule-form", data: { controller: "call-schedule" } do |form| %>
  <% if return_to.present? %>
    <%= hidden_field_tag :return_to, return_to, id: nil %>
  <% end %>

  <div class="call-schedule-header">
    <span class="call-schedule-title"><%= persisted ? "Reschedule call" : "Schedule call" %> · <%= owner.name %></span>
    <span class="call-schedule-tz">Pacific (<%= Time.zone.now.strftime("%Z") %>)</span>
  </div>

  <div class="call-schedule-quick" role="group" aria-label="Quick date and time picks">
    <button type="button" class="btn-secondary btn-xs" data-action="call-schedule#pickDate" data-call-schedule-date-param="<%= today_date.iso8601 %>">Today</button>
    <button type="button" class="btn-secondary btn-xs" data-action="call-schedule#pickDate" data-call-schedule-date-param="<%= tomorrow_date.iso8601 %>">Tomorrow</button>
    <button type="button" class="btn-secondary btn-xs" data-action="call-schedule#pickDate" data-call-schedule-date-param="<%= next_monday.iso8601 %>">Next Mon</button>
    <% ScheduledCall::QUICK_TIMES.each do |label, hhmm| %>
      <button type="button" class="btn-secondary btn-xs" data-action="call-schedule#pickTime" data-call-schedule-time-param="<%= hhmm %>"><%= label %></button>
    <% end %>
  </div>

  <div class="call-schedule-grid">
    <div>
      <%= form.label :scheduled_on, "Date", for: "#{prefix}_scheduled_on", class: "label" %>
      <%= form.date_field :scheduled_on, value: default_date, required: true, id: "#{prefix}_scheduled_on", class: "input", data: { call_schedule_target: "date" } %>
    </div>
    <div>
      <%= form.label :scheduled_time, "Time (Pacific)", for: "#{prefix}_scheduled_time", class: "label" %>
      <%= form.time_field :scheduled_time, value: default_time, required: true, id: "#{prefix}_scheduled_time", class: "input", data: { call_schedule_target: "time" } %>
    </div>
    <div>
      <%= form.label :duration_minutes, "Duration", for: "#{prefix}_duration_minutes", class: "label" %>
      <%= form.select :duration_minutes, ScheduledCall::DURATIONS.map { |mins| ["#{mins} min", mins] }, { selected: default_duration }, id: "#{prefix}_duration_minutes", class: "select" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, "Note (optional)", for: "#{prefix}_notes", class: "label" %>
    <%= form.text_field :notes, value: call.notes, placeholder: "Trip dates, questions to cover…", id: "#{prefix}_notes", class: "input" %>
  </div>

  <div class="call-schedule-actions">
    <%= form.submit button_text, class: "btn-primary btn-sm" %>
  </div>
<% end %>

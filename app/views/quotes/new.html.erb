<% content_for :title, "New quote · PerfectCRM" %>
<div class="page">
  <%= render layout: "shared/page_header", locals: { eyebrow: "Quote", title: "New quote", subtitle: "For #{@owner.name} · built from the PerfectBook catalog.", back: ["Quotes", quotes_path] } do %><% end %>
  <%= render "shared/flash" %>
  <% if @quote.errors.any? %>
    <div class="callout-danger callout" role="alert">
      <p class="font-medium">This quote needs attention.</p>
      <ul class="mt-1 list-disc pl-5 text-sm">
        <% @quote.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card card-pad" aria-labelledby="trip-heading">
    <div class="card-header">
      <h2 class="card-title" id="trip-heading">Trip and departure</h2>
    </div>
    <%= card_caption "Pick the trip, then the departure. Seats are live from PerfectBook; prices stay yours to enter." %>
    <%= form_with url: new_quote_path, method: :get, id: "catalog-picker", class: "mt-2 space-y-4" do |form| %>
      <%= hidden_field_tag :client_id, params[:client_id] %>
      <%= hidden_field_tag :lead_id, params[:lead_id] %>
      <div>
        <%= form.label :trip_id, "Trip", class: "label" %>
        <%= form.select :trip_id, options_from_collection_for_select(@trips, :perfectbook_id, :name, @trip&.perfectbook_id),
          { include_blank: "Choose a trip…" }, { class: "select", onchange: "this.form.requestSubmit()" } %>
      </div>
      <% if @trip %>
        <% if @departures.any? %>
          <fieldset>
            <legend class="label">Departure</legend>
            <div class="space-y-2" role="radiogroup" aria-label="Departures">
              <% @departures.each do |departure| %>
                <% label = departure.start_date && departure.end_date ? "#{departure.start_date.strftime('%-d %b')} – #{departure.end_date.strftime('%-d %b %Y')}" : (departure.label.presence || departure.place.presence || "Flexible dates") %>
                <% seats = departure.available_seats %>
                <label class="card flex cursor-pointer items-center gap-3 px-4 py-3 has-checked:bg-seal-tint has-checked:shadow-press">
                  <%= radio_button_tag :departure_id, departure.perfectbook_id, params[:departure_id].to_s == departure.perfectbook_id.to_s,
                    class: "h-4 w-4 accent-[#a85a12]", onchange: "this.form.requestSubmit()" %>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-ink"><%= label %></span>
                    <% if departure.place.present? %><span class="block text-xs muted"><%= departure.place %></span><% end %>
                  </span>
                  <% if seats.nil? %>
                    <span class="text-xs muted">Seats unknown</span>
                  <% elsif seats.positive? %>
                    <%= badge "#{seats} seats left", :info %>
                  <% else %>
                    <%= badge "Full", :danger %>
                  <% end %>
                </label>
              <% end %>
            </div>
            <p class="hint mt-2">PerfectBook lists no catalog price, so the price boxes below stay yours. Only your previously sent quotes can supply a price.</p>
          </fieldset>
        <% else %>
          <div class="empty-inline">
            <%= sketch :enso, class: "enso" %>
            <p class="text-sm text-ink">No upcoming departures.</p>
            <p class="text-xs muted">Build the quote with custom lines below instead.</p>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <%= form_with model: @quote, url: quotes_path, data: { controller: "quote-builder" }, class: "grid gap-6 lg:grid-cols-[3fr_2fr] lg:items-start" do |form| %>
    <%= hidden_field_tag :client_id, params[:client_id] %>
    <%= hidden_field_tag :lead_id, params[:lead_id] %>
    <%= form.hidden_field :perfectbook_trip_id %>
    <%= form.hidden_field :perfectbook_departure_id %>
    <%= form.hidden_field :trip_name %>

    <div class="space-y-6">
      <section class="card card-pad" aria-labelledby="lines-heading">
        <div class="card-header">
          <h2 class="card-title" id="lines-heading">Lines</h2>
          <button type="button" class="btn btn-ghost btn-sm" data-action="quote-builder#add">Add line</button>
        </div>
        <%= card_caption "Trip and departure lines snapshot the catalog; custom lines cover permits, single supplements, and extra nights." %>
        <% unless @prefilled_unit.nil? %><p class="hint">Prefilled from your last quote. Edit the price as needed.</p><% end %>
        <div class="space-y-3" data-quote-builder-target="rows">
          <%= form.fields_for :lines do |line_form| %>
            <%= render "line_fields", form: line_form %>
          <% end %>
        </div>
        <template data-quote-builder-target="template">
          <%= form.fields_for :lines, QuoteLine.new(quantity: 1), child_index: "__INDEX__" do |line_form| %>
            <%= render "line_fields", form: line_form %>
          <% end %>
        </template>
      </section>

      <section class="card card-pad" aria-labelledby="note-heading">
        <div class="card-header">
          <h2 class="card-title" id="note-heading">Note to the client</h2>
        </div>
        <%= card_caption "One personal paragraph travels with the quote, in the email and the PDF." %>
        <%= form.label :notes, "Note", class: "label mt-2" %>
        <%= form.text_area :notes, rows: 3, class: "textarea", placeholder: "I held two seats on the May 4 departure for you…" %>
        <%= form.label :included, "What is included", class: "label mt-4" %>
        <%= form.text_area :included, rows: 3, class: "textarea" %>
        <label class="mt-3 flex items-center gap-2 text-sm">
          <%= check_box_tag :remember_inclusions, "1", params[:remember_inclusions] == "1" %>
          Remember these inclusions for this trip
        </label>
      </section>
    </div>

    <div class="space-y-6">
      <section class="card card-pad" aria-labelledby="summary-heading">
        <div class="card-header">
          <h2 class="card-title" id="summary-heading">Summary</h2>
        </div>
        <%= card_caption "Check the total, set the terms, then send." %>
        <dl class="mt-2 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-3">
            <dt class="muted">Guests</dt>
            <dd><%= form.number_field :party_size, min: 1, class: "input w-24 text-right", data: { party_size: true, action: "input->quote-builder#recalc" } %></dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="muted">Deposit ($)</dt>
            <dd><%= form.text_field :deposit_dollars, class: "input w-28 text-right", inputmode: "decimal" %></dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="muted">Balance due</dt>
            <dd><%= form.date_field :balance_due_on, class: "input w-40" %></dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="muted">Valid until</dt>
            <dd><%= form.date_field :valid_until, class: "input w-40" %></dd>
          </div>
        </dl>
        <div class="mt-4 border-t border-rule-2 pt-4">
          <p class="text-xs muted" data-quote-builder-target="count">Total</p>
          <p class="font-display text-3xl tabular-nums text-ink" data-quote-builder-target="total">$0.00</p>
        </div>
        <div class="mt-4 flex flex-col gap-2">
          <%= form.button "Send quote", name: "send_now", value: "1", type: "submit", class: "btn btn-primary" %>
          <%= form.submit "Save draft", class: "btn btn-secondary" %>
        </div>
      </section>

      <section class="card card-pad" aria-labelledby="accept-heading">
        <div class="card-header">
          <h2 class="card-title" id="accept-heading">When they accept</h2>
        </div>
        <%= card_caption "What happens after the client taps the link." %>
        <ul class="mt-2 space-y-2 text-sm text-ink-2">
          <li class="flex items-start gap-2"><%= render "shared/icon", name: :check, class: "mt-0.5 h-4 w-4 text-good" %>They tap accept - no account needed.</li>
          <li class="flex items-start gap-2"><%= render "shared/icon", name: :check, class: "mt-0.5 h-4 w-4 text-good" %>You get an email and the timeline records it.</li>
          <li class="flex items-start gap-2"><%= render "shared/icon", name: :check, class: "mt-0.5 h-4 w-4 text-good" %>You create the booking in PerfectBook in one tap.</li>
        </ul>
      </section>
    </div>

    <div class="sticky bottom-0 z-10 -mx-1 flex items-center justify-between gap-3 border-t border-rule bg-paper/95 px-4 py-3 backdrop-blur lg:hidden" style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom))">
      <div class="min-w-0">
        <p class="font-display text-[22px] leading-none tabular-nums text-ink" data-quote-builder-target="total">$0.00</p>
        <p class="mt-0.5 truncate text-xs muted" data-quote-builder-target="count">Total</p>
      </div>
      <%= form.button "Send quote", name: "send_now", value: "1", type: "submit", class: "btn btn-primary min-h-11 min-w-24" %>
    </div>
  <% end %>
</div>

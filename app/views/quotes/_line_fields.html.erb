<%# One builder row: kind, description, quantity well, price each, live total. %>
<div class="grid grid-cols-[minmax(0,1.2fr)_minmax(0,0.7fr)_minmax(0,1fr)_2.75rem] sm:grid-cols-[minmax(0,1fr)_6rem_4.5rem_5.5rem_2.75rem] items-end gap-2 <%= "hidden" if form.object.marked_for_destruction? %>" data-line-row>
  <div class="col-span-4 min-w-0 sm:col-span-1">
    <%= form.label :description, "Description", class: "label sm:sr-only" %>
    <%= form.text_field :description, class: "input min-w-0", placeholder: "Everest Base Camp trek, permits…", data: { description: true } %>
  </div>
  <div class="min-w-0">
    <%= form.label :unit_dollars, "Each ($)", class: "label sm:sr-only" %>
    <%= form.text_field :unit_dollars, class: "input min-w-0 text-right", inputmode: "decimal", aria: { label: "Price each in dollars" }, data: { each: true, action: "input->quote-builder#editPrice" } %>
  </div>
  <div class="min-w-0">
    <%= form.label :quantity, "Qty", class: "label sm:sr-only" %>
    <%= form.number_field :quantity, min: 1, class: "input min-w-0 text-right", aria: { label: "Quantity" }, data: { qty: true, action: "input->quote-builder#recalc" } %>
  </div>
  <div class="min-w-0 break-words pb-2.5 text-right text-sm tabular-nums text-ink" data-line-total>$0.00</div>
  <div class="flex items-center gap-1 pb-1.5">
    <%= form.hidden_field :price_edited, value: form.object.price_edited || "1", data: { price_edited: true } %>
    <%= form.hidden_field :kind, value: form.object.kind.presence || "custom" %>
    <% if form.object.persisted? %>
      <%= form.hidden_field :_destroy, value: form.object.marked_for_destruction? ? "1" : "0", data: { destroy: true } %>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm min-h-11 min-w-11" data-action="quote-builder#remove" aria-label="Remove line">×</button>
  </div>
</div>

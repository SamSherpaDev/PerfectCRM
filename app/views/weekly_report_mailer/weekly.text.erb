Next review: <%= @summary.next_review.strftime('%b %-d, %Y') %>
<% if @summary.milestone %><%= report_milestone_line(@summary) %>
<% end %><% @summary.periods.each do |period| %><%= report_period_line(period) %>
<% end %>
<%= report_speed_line(@summary) %>
<% @summary.waiting.each do |lead| %>- <%= report_lead_name(lead) %>: <%= lead_url(lead) %>
<% end %><% if @summary.trips.any? %>
Trips this week:
<% @summary.trips.each do |trip| %>- <%= trip.trip %>: <%= trip.inquiries %> inq, <%= trip.qualified %> qual, <%= trip.booked %> booked
<% end %><% end %><% if @summary.total.inquiries.positive? %>
Came in from: <%= report_placements(@summary) %>

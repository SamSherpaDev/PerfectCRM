<p>Hi <%= @quote.owner_name %>,</p>

<p>Here is your quote <strong><%= @quote.reference %></strong> for <strong><%= @quote.subject_label %></strong><% if @quote.departure_label.present? %> (<%= @quote.departure_label %>)<% end %>.</p>

<ul>
  <% @quote.lines.each do |line| %>
    <li><%= line.description %> × <%= line.quantity %>: <%= money_in(line.total_minor, @quote.currency) %></li>
  <% end %>
</ul>

<p><strong>Total <%= money_in(@quote.subtotal_minor, @quote.currency) %></strong><% if @quote.party_size %> for <%= pluralize(@quote.party_size, "guest") %><% end %><% if @quote.valid_until %> · valid until <%= date_short(@quote.valid_until) %><% end %>.</p>

<% if @quote.included.present? %>
  <p><strong>What is included</strong><br><%= simple_format(@quote.included) %></p>
<% end %>
<% if @quote.notes.present? %>
  <p><strong>A note from Sam</strong><br><%= simple_format(@quote.notes) %></p>
<% end %>

<p>The full quote is attached as a PDF. To accept, tap the link below. You do not need an account.</p>
<% if @quote.terms_bundle.present? %>
  <p>Read the attached master terms <%= @quote.terms_bundle.fetch("terms_version") %>, pre-payment disclosure, itinerary and trip-specific differences before accepting or paying.</p>
  <p><strong>You cancel 45 days or fewer before departure: Cancellation charge: 100% of the total trip price. No refund.</strong></p>
  <p>The traveler-cancellation table does not remove our conditions promise, rights under an already accepted booking, or refunds and other rights required by law.</p>
<% end %>
<p><%= link_to "Accept quote #{@quote.reference}", @accept_url %></p>

<p>Questions? Just reply to this email.</p>

<%= @signature_html.html_safe %>

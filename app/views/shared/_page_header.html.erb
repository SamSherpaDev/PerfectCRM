<%# Page header. Render with a block for actions:
    render layout: "shared/page_header", locals: { title:, eyebrow:, subtitle:, back: [label, path] } do ... end
    The Everest drawing sits top-right above the actions and draws itself on load (docs/DESIGN.md 7, 8). %>
<header class="page-header">
  <%= sketch :everest, class: "sk hdr-ridge" %>
  <div class="relative min-w-0 sm:max-w-[62%]">
    <% if local_assigns[:back] %>
      <%= link_to local_assigns[:back][1], class: "link-quiet mb-4 inline-flex items-center gap-1.5 text-xs" do %>
        <%= render "shared/icon", name: :arrow_left, class: "h-3.5 w-3.5" %><%= local_assigns[:back][0] %>
      <% end %>
    <% end %>
    <% if local_assigns[:eyebrow] %><p class="eyebrow"><%= local_assigns[:eyebrow] %></p><% end %>
    <h1 class="display mt-1 text-[2rem] leading-tight sm:text-[2.6rem]"><%= title %></h1>
    <% if local_assigns[:subtitle] %><p class="mt-3 max-w-2xl text-[15px] leading-relaxed muted"><%= local_assigns[:subtitle] %></p><% end %>
  </div>
  <% actions = yield %>
  <% if actions.present? %>
    <div class="page-actions"><%= actions %></div>
  <% end %>
</header>

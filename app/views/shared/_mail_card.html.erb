<%# locals: (record:, conversations:) %>
<%# Email card for client, lead, and organization pages. Renders linked threads newest first. %>
<section class="card card-pad" aria-labelledby="email-heading">
  <div class="card-header">
    <h2 class="card-title" id="email-heading">Email</h2>
    <%= link_to "Open inbox", inbox_path(tab: "all"), class: "link-quiet text-xs" %>
  </div>
  <%= card_caption "Every message to and from #{Mail.mailbox_address} on this record, newest first. Attachments stay inline." %>
  <% messages = Message.where(conversation: conversations).newest_first.limit(20).includes(files_attachments: :blob) %>
  <div id="record-mail-newest"></div>
  <%= render "shared/mail_stream", messages: messages %>
  <% if messages.any? %>
    <p class="mt-3 text-xs"><a href="#record-mail-newest" class="link-quiet">Jump to newest ↑</a></p>
  <% end %>
</section>

<%# locals: (record:, conversations:) %>
<%# Email card for client, lead, and organization pages. Renders linked threads newest first. %>
<section class="card card-pad" aria-labelledby="email-heading">
  <div class="card-header">
    <h2 class="card-title" id="email-heading">Email</h2>
    <%= link_to "Open inbox", inbox_path(tab: "all"), class: "link-quiet text-xs" %>
  </div>
  <%= card_caption "Every message to and from #{Mail.mailbox_address} on this record, newest first. Attachments stay inline." %>
  <% page = [ params[:mail_page].to_i, 1 ].max %>
  <% all_messages = Message.where(conversation: conversations).newest_first %>
  <% messages = all_messages.offset((page - 1) * 20).limit(20).includes(files_attachments: :blob) %>
  <div id="record-mail-newest"></div>
  <%= render "shared/mail_stream", messages: messages %>
  <% if all_messages.offset(page * 20).exists? %>
    <%= link_to "Load older", url_for(request.query_parameters.merge(mail_page: page + 1, anchor: "email-heading")), class: "btn-secondary btn mt-3" %>
  <% end %>
  <% if messages.any? %>
    <p class="mt-3 text-xs"><%= link_to "Jump to newest ↑", url_for(request.query_parameters.merge(mail_page: 1, anchor: "record-mail-newest")), class: "link-quiet" %></p>
  <% end %>
</section>

<%# locals: (message:) %>
<%# One stone in the stream timeline: inbound raised left, outbound pressed right. %>
<% inbound = message.inbound? %>
<article class="stone <%= inbound ? "stone-in" : "stone-out" %>" id="message-<%= message.id %>">
  <div class="flex items-start gap-2">
    <% if message.unread? %>
      <span class="unread-dot mt-1.5" aria-label="Unread"></span>
    <% end %>
    <div class="min-w-0 flex-1">
      <p class="text-[11.5px] font-medium muted">
        <%= inbound ? "From #{message.from_address}" : "You to #{message.to_list.first(2).join(", ")}" %>
        · <%= date_short(message.sent_at || message.created_at) %>
      </p>
      <% if message.outbound? && message.status != "received" %>
        <%= delivery_badge(message.status) %>
        <% if message.failed? %>
          <p class="mt-2 text-xs text-bad">Could not deliver: <%= message.send_error.presence || "unknown error" %></p>
          <%= button_to "Retry", retry_message_path(message), method: :post, class: "btn btn-secondary btn-sm mt-1" %>
        <% end %>
      <% end %>
      <% if message.subject.present? %>
        <p class="mt-1 font-semibold text-ink text-[13px]"><%= message.subject %></p>
      <% end %>
      <%= render "shared/message_body", message: message, attachments: :rows %>
      <% if message.label_list.any? %>
        <p class="stone-meta">Labels: <%= message.label_list.join(", ") %></p>
      <% end %>
    </div>
  </div>
</article>

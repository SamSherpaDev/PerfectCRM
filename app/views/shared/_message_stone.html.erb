<%# locals: (message:) %>
<%# One stone in the stream timeline: inbound raised left, outbound pressed right. %>
<% inbound = message.inbound? %>
<article class="stone <%= inbound ? "stone-in" : "stone-out" %>" id="message-<%= message.id %>">
  <div class="flex items-start gap-2">
    <% if message.unread? %>
      <span class="unread-dot mt-1.5" aria-label="Unread"></span>
    <% end %>
    <div class="min-w-0 flex-1">
      <p class="text-[11.5px] font-medium muted">
        <%= inbound ? "From #{message.from_address}" : "You to #{message.to_list.first(2).join(", ")}" %>
        · <%= date_short(message.sent_at) %>
      </p>
      <% if message.subject.present? %>
        <p class="mt-1 font-semibold text-ink text-[13px]"><%= message.subject %></p>
      <% end %>
      <% body = message.text_body.presence || ActionView::Base.full_sanitizer.sanitize(message.html_body.to_s).squish %>
      <% if body.length > 600 %>
        <details>
          <summary class="link-quiet cursor-pointer text-[12.5px]">Read message</summary>
          <div class="mt-2 whitespace-pre-line text-ink-2"><%= truncate(body, length: 4000) %></div>
        </details>
        <p class="mt-1 text-ink-2 whitespace-pre-line"><%= truncate(body, length: 280) %></p>
      <% else %>
        <div class="mt-1 whitespace-pre-line text-ink-2"><%= body.presence || "No text in this message." %></div>
      <% end %>
      <% if message.html_body.present? && message.text_body.blank? %>
        <div class="mt-2 text-ink-2 prose-sm"><%= sanitize(message.html_body, tags: Mail::Sanitizer::ALLOWED_TAGS, attributes: Mail::Sanitizer::ALLOWED_ATTRIBUTES) %></div>
      <% end %>
      <% if message.files.attached? %>
        <% linkable = message.conversation.linkable %>
        <% pb_bookings = linkable.try(:perfectbook_contact_id).present? ? PerfectBook::Booking.where(perfectbook_contact_id: linkable.perfectbook_contact_id).limit(20).to_a : [] %>
        <ul class="thread-attachments" aria-label="Attachments">
          <% message.files.each do |file| %>
            <li class="attachment-row">
              <%= render "shared/icon", name: :copy, class: "h-3.5 w-3.5" %>
              <span class="min-w-0 flex-1 truncate"><%= file.filename %> · <%= number_to_human_size(file.byte_size) %></span>
              <%= link_to "Download", attachment_path(file.id), class: "link text-xs" %>
              <%= form_with url: move_to_perfectbook_attachment_path(file.id), method: :post, class: "flex flex-wrap items-center gap-1.5" do |form| %>
                <% if pb_bookings.any? %>
                  <%= form.select :booking_id, options_for_select(pb_bookings.map { |booking| [ "#{booking.trip_name.presence || booking.ref} · #{booking.ref}", booking.perfectbook_id ] }), { include_blank: "Pick booking" }, class: "select", aria: { label: "Booking for #{file.filename}" } %>
                <% end %>
                <%= form.submit "Move to PerfectBook", class: "btn-ghost btn btn-sm", data: { turbo_confirm: "Move #{file.filename} to PerfectBook and delete it here?" } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if message.label_list.any? %>
        <p class="stone-meta">Labels: <%= message.label_list.join(", ") %></p>
      <% end %>
    </div>
  </div>
</article>

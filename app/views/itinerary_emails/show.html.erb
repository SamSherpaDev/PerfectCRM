<% content_for :title, "Itinerary email · PerfectCRM" %>
<div class="page">
  <% back = @lead ? [ @lead.name.presence || "Lead", lead_path(@lead) ] : [ "Settings", edit_settings_path ] %>
  <% subtitle = @lead ? "The email for this inquiry, worded as it would send now." : "The automatic email for itinerary designer visitors, as they receive it. Read it here before switching it on." %>
  <%= render layout: "shared/page_header", locals: { eyebrow: "Settings", title: "Itinerary email", subtitle: subtitle, back: back } do %><% end %>
  <%= render "shared/flash" %>

  <section class="card card-pad" aria-labelledby="itinerary-email-status-heading">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="section-title" id="itinerary-email-status-heading">Status</h2>
      <% if @settings.itinerary_email_enabled? %>
        <%= badge "On", :success, dot: true %>
      <% else %>
        <%= badge "Off", :neutral, dot: true %>
      <% end %>
    </div>
    <% if @settings.itinerary_email_enabled? %>
      <p class="mt-2 text-sm text-ink">On since <%= itinerary_moment(@settings.itinerary_email_enabled_at) %>. Itinerary designer inquiries that arrive from then on get this email about a minute after they send their trip.</p>
    <% else %>
      <p class="mt-2 text-sm text-ink">Nothing is sent. Switch it on under Automations once the wording reads right.</p>
    <% end %>
    <p class="hint mt-2">While it is on, the automatic first reply skips itinerary designer visitors, because this email has already reached them. Sam or Gyalgin follow up by hand with two call times.</p>
    <p class="mt-3"><%= link_to "Automations in Settings", edit_settings_path(anchor: "automations-heading"), class: "link text-sm" %></p>
  </section>

  <div>
    <% if @lead %>
      <p class="hint">The call paragraph reads <%= @call_requested ? "as for a visitor who asked for a call" : "as for a visitor who has not asked for a call yet" %>.</p>
    <% else %>
      <nav class="tabs" aria-label="Email version">
        <%= tab_link "Asked for a call", settings_itinerary_email_path, icon: :phone, active: @call_requested %>
        <%= tab_link "No call request yet", settings_itinerary_email_path(call: 0), icon: :mail, active: !@call_requested %>
      </nav>
      <p class="hint mt-3">The call paragraph depends on whether the visitor picked a call time before the email went out. The sample trip below is the designer's “Easy days” draft.</p>
    <% end %>

    <section class="card card-pad mt-4" aria-labelledby="itinerary-email-preview-heading">
      <h2 class="sr-only" id="itinerary-email-preview-heading">Email preview</h2>
      <dl class="space-y-1 text-sm">
        <div class="flex gap-2"><dt class="muted">From</dt><dd class="min-w-0 break-words"><%= Outbound::Composer.from_display %></dd></div>
        <div class="flex gap-2"><dt class="muted">To</dt><dd class="min-w-0 break-words"><%= @recipient %></dd></div>
        <div class="flex gap-2"><dt class="muted">Subject</dt><dd class="min-w-0 break-words"><%= @content[:subject] %></dd></div>
      </dl>
      <div class="report-paper email-paper mt-4">
        <%= simple_format(h(@content[:body])) %>
        <%== EmailSignature.html_for(@settings, logo_src: logo_settings_path) %>
      </div>
    </section>
  </div>
</div>

# Litestream container env. On the VPS: copy to
# /opt/apps/perfectcrm/.env.litestream, root-owned mode 600.
# Backup-bucket credentials only; the app never sees these.
# S3-compatible endpoint/region (duplicated here so the litestream container
# resolves on its own). Same provider convention as .env.app.example.
SPACES_REGION=
SPACES_ENDPOINT=
# Private database-backup bucket and separate read/write access credentials.
LITESTREAM_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

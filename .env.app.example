# App container env. On the VPS: copy to /opt/apps/perfectcrm/.env.app,
# root-owned mode 600. Never commit populated credentials.
# Generate a unique production secret with bin/rails secret.
SECRET_KEY_BASE=
# Stored-token encryption setup and key preservation: docs/operations.md, "Secrets inventory".
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# Google OAuth web client; allow only the captain for the MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=info@sherpaholidays.com
# S3-compatible bucket values (Cloudflare R2 by default; Backblaze B2 also
# works). The SPACES_* names are historical; they carry whichever provider's
# values. Endpoint is the account/regional HTTPS endpoint (not a bucket URL);
# region is 'auto' for R2, the bucket region (e.g. us-west-004) for B2.
SPACES_REGION=
SPACES_ENDPOINT=
# Private attachment bucket and its read/write access credentials (attachments only).
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Application mail configuration: see docs/operations.md, "Secrets inventory".
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# PerfectBook read API (see README.md, "PerfectBook connection").
PERFECTBOOK_BASE_URL=https://perfectbook.sherpaholidays.com
PERFECTBOOK_API_TOKEN=
